            margin-top: 1.25rem;
        }

        .topbar-panel--software-reviews .topbar-panel__media img.skip-lazy {
            width: auto;
            max-width: 100%;
        }

        .topbar-panel--g2 {
            background-position: 100% 100%;
            justify-content: center;
            top: -3px !important;
            background-size: cover !important;
            background-repeat: no-repeat;
            display: flex;
            border-bottom: none !important;
            border-top: none !important;
            background-image: url(https://www.searchunify.com/wp-content/themes/seoinux-child/assets/img/G2-25Quarters.webp) !important;
        }

        .topbar-panel--g2 .topbar-panel__media {
            align-items: center;
        }

        .topbar-panel--g2 .topbar-panel__media img.skip-lazy {
            max-width: min(100%, 540px);
        }

        .topbar-panel--g2 .webinar-subtitle {
            font-size: 20px;
            font-weight: 600;
            font-family: Montserrat;
        }

        .topbar-panel--g2 .webinar-title-h3 {
            font-size: 34px;
            font-weight: 700;
            line-height: 34px;
        }

        .bi-arrow-right::before {
            position: relative;
            top: 1px;
        }

        @media (max-width: 1440px) {
            .topbar-panel__content .webinar-title-h3 {
                font-size: 30px;
                line-height: 1.2;
            }
        }

        @media only screen and (max-width: 1250px) {
            .topbar-panel--g2 .webinar-title-h3 {
                font-size: 30px;
            }

            .topbar-panel--knowledge-base {
                background-position: calc(34% + 20px) center;
            }
        }

        /* Debug toolbar (when DEBUG_WEBINAR or ?debug_webinar=1, injected by JS) */
        .webinar-debug-toolbar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 999999;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            background: #1a1a2e;
            color: #eee;
            font-size: 12px;
            flex-wrap: wrap;
            border-bottom: 2px solid #ff6b35;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .webinar-debug-label {
            font-weight: 600;
            margin-right: 4px;
        }

        .webinar-debug-btn {
            padding: 4px 10px;
            font-size: 11px;
            cursor: pointer;
            background: #333;
            color: #fff;
            border: 1px solid #555;
            border-radius: 4px;
        }

        .webinar-debug-btn:hover {
            background: #444;
        }

        .webinar-debug-close {
            margin-left: 4px;
            background: #5c2a2a;
            border-color: #7a3a3a;
        }

        .webinar-debug-close:hover {
            background: #6e3535;
        }</style> <script type="litespeed/javascript">document.addEventListener('DOMContentLiteSpeedLoaded',function(){'use strict';const DEBUG_WEBINAR=!1;const DEBUG_WEBINAR_URL=typeof URLSearchParams!=='undefined'&&new URLSearchParams(window.location.search).get('debug_webinar')==='1';const DEBUG_ACTIVE=DEBUG_WEBINAR||DEBUG_WEBINAR_URL;const CLOSE_DELAY=150;const isDesktop=window.matchMedia('(hover: hover) and (pointer: fine)').matches;if(!isDesktop&&!DEBUG_ACTIVE)return;function debugLog(msg,data=''){if(DEBUG_ACTIVE){console.log('[Webinar]',msg,data)}}
let closeTimeout=null;let webinarPanels=null;let isPanelVisible=!1;function hideAllPanels(){if(!webinarPanels)return;webinarPanels.forEach(p=>p.classList.remove('active'));isPanelVisible=!1;debugLog('hideAllPanels')}
function showPanelById(panelId){if(!webinarPanels)return;hideAllPanels();const panel=Array.from(webinarPanels).find(p=>p.dataset.panelId===panelId);if(panel){panel.classList.add('active');isPanelVisible=!0;debugLog('showPanelById',panelId)}}
function cancelClose(){if(closeTimeout){clearTimeout(closeTimeout);closeTimeout=null}}
function scheduleClose(){if(DEBUG_ACTIVE)return;cancelClose();closeTimeout=setTimeout(hideAllPanels,CLOSE_DELAY)}
function injectDebugToolbar(){if(!DEBUG_ACTIVE||!webinarPanels||!webinarPanels.length)return;const existing=document.querySelector('.webinar-debug-toolbar');if(existing)return;const toolbar=document.createElement('div');toolbar.className='webinar-debug-toolbar';toolbar.innerHTML='<span class="webinar-debug-label">Webinar debug:</span>';Array.from(webinarPanels).forEach(panel=>{const id=panel.dataset.panelId;if(!id)return;const btn=document.createElement('button');btn.type='button';btn.className='webinar-debug-btn';btn.textContent=id;btn.addEventListener('click',()=>{showPanelById(id);debugLog('Panel opened manually',id)});toolbar.appendChild(btn)});const closeBtn=document.createElement('button');closeBtn.type='button';closeBtn.className='webinar-debug-btn webinar-debug-close';closeBtn.textContent='Close all';closeBtn.addEventListener('click',()=>{hideAllPanels();debugLog('Panels closed manually')});toolbar.appendChild(closeBtn);document.body.appendChild(toolbar);debugLog('Debug toolbar injected')}
function initializeWebinarPanel(){const topbarSlider=document.querySelector('.topbar-slider');if(!topbarSlider)return;webinarPanels=document.querySelectorAll('.webinar-panel');if(!webinarPanels.length)return;if(DEBUG_ACTIVE)injectDebugToolbar();topbarSlider.addEventListener('pointerenter',function(e){if(e.target.closest('.webinar-debug-toolbar'))return;const banner=e.target.closest('.webinar-banner');if(!banner)return;cancelClose();const panelId=banner.dataset.panelId;if(panelId)showPanelById(panelId);},!0);topbarSlider.addEventListener('pointerleave',function(e){if(e.target.closest('.webinar-debug-toolbar'))return;if(isPanelVisible)scheduleClose();});webinarPanels.forEach(panel=>{panel.addEventListener('pointerenter',cancelClose);panel.addEventListener('pointerleave',scheduleClose)})}
initializeWebinarPanel();function initTopbarRotator(){var wrapper=document.querySelector('.sutopbar.topbar-wrapper');if(!wrapper||wrapper.dataset.suRotatorInit)return;if(wrapper.classList.contains('slick-initialized'))return;wrapper.dataset.suRotatorInit='1';wrapper.classList.add('su-rotator-active');var items=Array.from(wrapper.querySelectorAll('.su-asp-webinar-25-item'));if(items.length<=1)return;var current=0;items[0].classList.add('su-tb-active');setInterval(function(){items[current].classList.remove('su-tb-active');current=(current+1)%items.length;items[current].classList.add('su-tb-active')},2500)}
window.addEventListener('load',()=>{setTimeout(function(){initializeWebinarPanel();initTopbarRotator();if(DEBUG_ACTIVE)injectDebugToolbar();},500)})})</script> </li></li></ul></div></div><div class="sticky-outer" data-stickyup="0"><div class="sticky-head"><div class="header-navbar navbar elements-3"><div class="container-fluid"><ul class="nav navbar-ul element-left right-element-exist"><li class="header-titles-wrapper"><div class="header-titles">
