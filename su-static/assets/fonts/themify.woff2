            min-width: 0;
            max-width: calc(100% - 120px) !important;
        }

        .topbar-panel__content {
            --primary-dark: #0a0e1a;
            --secondary-dark: #151923;
            --accent-orange: #ff6b35;
            --text-light: #f8f9fa;
            --text-muted: #adb5bd;
            --card-bg: #151923;
            --transition-speed: 0.3s;
            --container-width: 1400px;
