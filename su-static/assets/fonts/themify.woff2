/* Start custom CSS for ceatab, class: .elementor-element-46c7216 */.nav.nav-tabs.cea-tabs .nav-link.active {
    background-color: #FF7300;
    border-radius: 6px;
    padding: 16px 20px;
    color: #000;
}
.card-p {
    font-family: Poppins;
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    color: #000000;
}
.card-p a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    border: 1px solid #ff7300;
    background: #ffffff;
    border-radius: 24px;
    min-width: 180px;
    padding: 8px 0px;
    position: absolute;
    bottom: 140px;
}
p.card-p {
    position: relative;
    top: 199px;
    left: 307px;
    margin-bottom: 78px;
}
.all-rc .card h3 {
    color: #000;
    font-family: poppins;
}/* End custom CSS */
