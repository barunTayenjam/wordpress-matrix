# WordPress site directories (user content, not part of core app)
wp_*/

# WordPress core files generated by installs
wp-config.php
wp-config-*.php
wp-settings.php
wp-load.php
license.txt
readme.html

# WordPress content directories
wp-content/uploads/
wp-content/cache/
wp-content/backups/
wp-content/upgrade/
wp-content/languages/

# Database dumps and backups
*.sql
*.sql.gz
*.dump
*.sql.tar.gz
backup-*.sql
wp-*.sql
backups/

# Log files
*.log
logs/
wp-logs/
error.log
debug.log

# Runtime PID files
.frontend.pid

# Temporary files
*.tmp
*.temp
tmp/
temp/
.DS_Store
*.DS_Store

# Environment files (credentials/security)
.env
.env.local
.env.production
.env.*.local
.env.*.production
wp-config-private.php

# Composer dependencies
vendor/
composer.lock

# IDE and system files
.vscode/
.idea/
*.swp
*.swo
.qwen/
Thumbs.db
.Spotlight-V100
.Trashes
apdisk/

# Uploaded media files (user-generated content)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.svg
!docs/*.svg
!frontend/public/icons/*.svg
*.webp
*.pdf
*.doc
*.docx

# ...but the brand assets are source, not uploaded media. The blanket
# patterns above exist to keep WordPress uploads out of git; brand files
# are hand-maintained masters and must be versioned.
!docs/logo*.svg
!docs/icons/*.svg
!docs/icons/*.png
!docs/icons/*.ico
!docs/icons/*.webmanifest
*.xls
*.xlsx
*.ppt
*.pptx
*.zip
*.rar
*.tar
*.gz

# Cache and session files
*.cache
.cache/
opcache/
wp-cache/
sess_*

# SSL certificates (keep config templates, ignore keys/certs)
# NOTE: '**' is required - a bare '*' does not cross directory boundaries, so
# ssl-certs/*.key silently misses per-site certs at ssl-certs/<site>/server.key.
ssl-certs/**/*.key
ssl-certs/**/*.crt
ssl-certs/**/*.csr
ssl-certs/**/*.pem
ssl-certs/**/*.p12
ssl-certs/**/*.jks
ssl-certs/**/*.keystore
# Belt-and-braces: any unexpected non-template file under a cert dir.
# *.conf templates at the top level stay tracked.
ssl-certs/*/*
!ssl-certs/*/*.conf

# Test coverage reports
tests/coverage/
*.lcov

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Root-level Node.js dependencies
node_modules/

# Docker compose files (contain site-specific details, regenerated by repair)
docker-compose.yml
docker-compose.*.yml
!docker-compose.simple.yml
!tests/bash/fixtures/docker-compose.yml

# Nginx site configs (regenerated by repair, keep only default)
config/nginx/*.conf
!config/nginx/default.conf

# Graphify output (generated, not source)
graphify-out/

# Planning directory (not part of core app)
.planning/

# Static files (su-static)
su-static/
