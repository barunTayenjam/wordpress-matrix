        log_error "Child theme directory already exists: $theme_dir"
        return 1
    fi

    log_info "Creating child theme '$name'..."
    mkdir -p "$theme_dir"

    cat > "$theme_dir/style.css" << EOF
/*
Theme Name: $name
Template: parent-theme
Description: Child theme created with WordPress Matrix
Version: 1.0.0
Text Domain: $name
*/
EOF

    cat > "$theme_dir/functions.php" << 'EOF'
<?php
defined('ABSPATH') || exit;
EOF

    log_success "Child theme '$name' created at $theme_dir"
}

# Apply preset to a site
apply_preset() {
    local site_name="${1:-}"
    local preset="${2:-}"

    if [[ -z "$site_name" || -z "$preset" ]]; then
        return 1
    fi

    local site_dir="$PROJECT_ROOT/wp_$site_name"
    local plugins_dir="$site_dir/wp-content/plugins"
    local themes_dir="$site_dir/wp-content/themes"

    mkdir -p "$plugins_dir" "$themes_dir"

    case "$preset" in
        "blank")
            log_info "Blank preset — nothing to install"
            ;;
        "woocommerce")
            log_info "Installing WooCommerce preset..."
            run_wp_cli "$site_name" plugin install woocommerce --activate --allow-root 2>/dev/null || \
                log_warning "WooCommerce installation may have failed"
            ;;
        "elementor")
            log_info "Installing Elementor preset..."
            run_wp_cli "$site_name" plugin install elementor --activate --allow-root 2>/dev/null || \
                log_warning "Elementor installation may have failed"
            ;;
        "bbpress")
            log_info "Installing bbPress preset..."
            run_wp_cli "$site_name" plugin install bbpress --activate --allow-root 2>/dev/null || \
                log_warning "bbPress installation may have failed"
            ;;
        "buddypress")
            log_info "Installing BuddyPress preset..."
            run_wp_cli "$site_name" plugin install buddypress --activate --allow-root 2>/dev/null || \
                log_warning "BuddyPress installation may have failed"
            ;;
        "multisite")
            local port
            port=$(get_site_port "$site_name")
            run_wp_cli "$site_name" core install \
                --url="http://${HOST_IP}:${port:-80}" \
                --title="WordPress Multisite" \
                --admin_user=admin --admin_password=admin \
                --admin_email=admin@example.com --allow-root 2>/dev/null || true
            log_info "Enabling Multisite..."
            cat >> "$site_dir/wp-config.php" << 'EOF'

// Enable Multisite
define('WP_ALLOW_MULTISITE', true);
EOF
            ;;
        *)
            log_warning "Unknown preset: $preset"
            return 1
            ;;
    esac

    log_success "Preset '$preset' applied to '$site_name'"
}

watch_site() {
    local site_name="${1:-}"
    local site_path=""

    if [[ -z "$site_name" ]]; then
        log_error "Usage: ./matrix watch <site-name>"
        return 1
    fi

    if [[ ! -d "$PROJECT_ROOT/wp_$site_name" ]]; then
        log_error "Site not found: $site_name"
        return 1
    fi

    site_path="$PROJECT_ROOT/wp_$site_name"
    log_info "Watching $site_path for changes..."

    local last_check=0
    local poll_interval=2

    if command -v fswatch >/dev/null 2>&1; then
        log_info "Using fswatch for file monitoring"
        fswatch -r "$site_path" --exclude=.git --exclude=node_modules --exclude=vendor --exclude=cache 2>/dev/null | while read -r event; do
            echo "Change detected: $event"
            $CONTAINER_RUNTIME exec "wp_$site_name" php -r "opcache_get_status()['opcache_enabled'] && opcache_reset();" 2>/dev/null || true
        done
    else
        log_info "Using polling mode (install fswatch for better performance)"
        log_info "Press Ctrl+C to stop watching"
        while true; do
            local current_mtime=$(find "$site_path/wp-content" -type f -name "*.php" -mmin -"$poll_interval" 2>/dev/null | head -1 | xargs stat -f %m 2>/dev/null || echo "0")
            if [[ "$current_mtime" != "$last_check" && "$last_check" != "0" ]]; then
                echo "Change detected, clearing OPcache..."
                $CONTAINER_RUNTIME exec "wp_$site_name" php -r "if (function_exists('opcache_get_status') && opcache_get_status()) { opcache_reset(); echo 'OPcache cleared'; }" 2>/dev/null || echo "Could not clear OPcache"
            fi
            last_check=$current_mtime
            sleep "$poll_interval"
        done
    fi
}

list_presets() {
    log_info "Available Site Presets:"
    echo ""
    printf "%-15s %-40s\n" "Preset" "Description"
    echo "─────────────────────────────────────────────────────────────────"
    printf "%-15s %-40s\n" "blank" "Empty WordPress installation"
    printf "%-15s %-40s\n" "woocommerce" "WooCommerce with starter theme"
    printf "%-15s %-40s\n" "elementor" "Elementor page builder"
    printf "%-15s %-40s\n" "bbpress" "bbPress forum plugin"
    printf "%-15s %-40s\n" "buddypress" "BuddyPress social network"
    printf "%-15s %-40s\n" "multisite" "WordPress Multisite"
    echo ""
    echo "Usage: ./matrix create mysite --preset=woocommerce"
}

# Frontend management
manage_frontend() {
    local action="${1:-}"

    if [[ -z "$action" ]]; then
        log_error "Usage: ./matrix frontend <start|stop|restart|status>"
        return 1
    fi

    local frontend_dir="$PROJECT_ROOT/frontend"
    local pid_file="$PROJECT_ROOT/.frontend.pid"
    local log_file="$PROJECT_ROOT/logs/frontend.log"

    # Create logs directory if it doesn't exist
    mkdir -p "$(dirname "$log_file")"

    case "$action" in
        "start")
            # Check if port 8500 is already in use
            local port_pids=$(lsof -ti:8500 2>/dev/null | tr '\n' ' ')
            if [[ -n "$port_pids" ]]; then
                # Check if it's already our frontend
                if [[ -f "$pid_file" ]]; then
                    local existing_pid=$(cat "$pid_file")
                    # Check if any of the port PIDs match our expected PID
                    local match=false
                    for pid in $port_pids; do
                        if [[ "$pid" == "$existing_pid" ]]; then
                            match=true
                            break
                        fi
                    done
                    if $match && ps -p "$existing_pid" > /dev/null 2>&1; then
                        log_warning "Frontend is already running on port 8500 (PID: $existing_pid)"
                        return 0
                    fi
                fi
                # Port is in use by leftover processes - kill them all
                log_warning "Cleaning up leftover processes on port 8500..."
                for pid in $port_pids; do
                    kill -9 "$pid" 2>/dev/null || true
                done
                sleep 1
            fi

            if [[ ! -d "$frontend_dir" ]]; then
                log_error "Frontend directory not found: $frontend_dir"
                return 1
            fi

            log_info "Starting frontend..."
            cd "$frontend_dir" || return 1

            MATRIX_LAN_IP="$HOST_IP" PORT=8500 npm start > "$log_file" 2>&1 &
            local pid=$!
            echo $pid > "$pid_file"

            sleep 2
            if ps -p "$pid" > /dev/null 2>&1; then
                log_success "Frontend started: http://$HOST_IP:8500 (PID: $pid)"
            else
                log_error "Failed to start frontend. Check logs: $log_file"
                rm -f "$pid_file"
                tail -20 "$log_file" 2>/dev/null || true
                return 1
            fi
            ;;
        "stop")
            # Check if frontend is running (by PID file or by port)
            local is_running=false
            local current_pid=""

            if [[ -f "$pid_file" ]]; then
                current_pid=$(cat "$pid_file")
                if ps -p "$current_pid" > /dev/null 2>&1; then
                    is_running=true
                fi
            fi

            # Kill ALL processes on port 8500 (handle stale/leftover processes)
            local port_pids=$(lsof -ti:8500 2>/dev/null | tr '\n' ' ')
            if [[ -n "$port_pids" ]]; then
                is_running=true
                if [[ -z "$current_pid" ]]; then
                    current_pid=$(echo "$port_pids" | awk '{print $1}')
                fi
            fi

            if ! $is_running; then
                log_warning "Frontend is not running"
                rm -f "$pid_file"
                return 0
            fi

            log_info "Stopping frontend (PID: $current_pid)..."
            # Kill all found PIDs on port 8500
            for pid in $port_pids; do
                kill "$pid" 2>/dev/null || true
            done
            sleep 1

            for pid in $port_pids; do
                if ps -p "$pid" > /dev/null 2>&1; then
                    kill -9 "$pid" 2>/dev/null || true
                fi
            done

            rm -f "$pid_file"
            log_success "Frontend stopped"
            ;;
        "restart")
            log_info "Restarting frontend..."
            manage_frontend stop
            sleep 1
            manage_frontend start
            ;;
        "status")
            local is_running=false
            local pid=""

            if [[ -f "$pid_file" ]]; then
                pid=$(cat "$pid_file")
                if ps -p "$pid" > /dev/null 2>&1; then
                    is_running=true
                fi
            fi

            # Also check by port
            if ! $is_running; then
                local port_pid=$(lsof -ti:8500 2>/dev/null)
                if [[ -n "$port_pid" ]]; then
                    is_running=true
                    pid=$port_pid
                fi
            fi

            if $is_running; then
                echo "Frontend: Running (http://$HOST_IP:8500) - PID: $pid"
            else
                echo "Frontend: Stopped"
            fi
            ;;
        *)
            log_error "Unknown action: $action"
            log_info "Available: start, stop, restart, status"
            return 1
            ;;
    esac
}

repair_env() {
    local site_name="${1:-}"
    local fixed_count=0
    local checked_count=0

    log_info "Scanning for issues..."

    if [[ ! -f "$COMPOSE_FILE" ]]; then
        log_warning "docker-compose.yml missing - recreating base file..."
        rebuild_compose_base
        fixed_count=$((fixed_count + 1))
        log_success "Created base docker-compose.yml"
    fi

    if [[ ! -d "$PROJECT_ROOT/config/nginx" ]]; then
        mkdir -p "$PROJECT_ROOT/config/nginx"
        log_warning "Created missing config/nginx/ directory"
        fixed_count=$((fixed_count + 1))
    fi

    if [[ ! -f "$PROJECT_ROOT/config/nginx/default.conf" ]]; then
        cat > "$PROJECT_ROOT/config/nginx/default.conf" << 'NGINXEOF'
server {
    listen 80 default_server;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass localhost:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
}
NGINXEOF
        log_success "Created default nginx config"
        fixed_count=$((fixed_count + 1))
    fi

    if [[ ! -f "$PROJECT_ROOT/.env" ]]; then
        log_warning ".env file missing - creating default..."
        cat > "$PROJECT_ROOT/.env" << 'ENVEOF'
# WordPress Environment
MYSQL_USER=wp_user
MYSQL_PASSWORD=wp_password
MYSQL_ROOT_PASSWORD=root_password
WP_DEBUG=true
ENVEOF
        log_success "Created .env file"
        chmod 600 "$PROJECT_ROOT/.env"
        fixed_count=$((fixed_count + 1))
    fi
    
    mkdir -p "$PROJECT_ROOT/logs"

    local sites_tmp
    sites_tmp=$(mktemp)
    get_sites > "$sites_tmp"
    local site_list
    site_list=$(cat "$sites_tmp")
    rm -f "$sites_tmp"

    if [[ -n "$site_name" ]]; then
        if ! site_exists "$site_name"; then
            log_error "Site '$site_name' not found (no wp_$site_name directory)"
            return 1
        fi
        site_list="$site_name"
    fi

    while IFS= read -r site || [[ -n "$site" ]]; do
        [[ -z "$site" ]] && continue
        if ! validate_site_name "$site" >/dev/null 2>&1; then
            log_warning "[$site] Skipping — invalid site name"
            continue
        fi
        checked_count=$((checked_count + 1))
        local site_fixed=0

        local nginx_conf="$PROJECT_ROOT/config/nginx/$site.conf"
        local site_stack
        site_stack=$(get_site_stack "$site")
        if [[ "$site_stack" == "nginx" && ! -f "$nginx_conf" ]]; then
            log_warning "[$site] Missing nginx config"
            cat > "$nginx_conf" << EOF
server {
    listen 80;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php\$ {
        fastcgi_pass wp_$site:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 32k;
    }

    location ~ /\. {
        deny all;
    }
}
EOF
            log_success "[$site] Created nginx config"
            site_fixed=$((site_fixed + 1))
        fi

        local in_compose=false
        if [[ -f "$COMPOSE_FILE" ]] && grep -q "^  wp_${site}:" "$COMPOSE_FILE" 2>/dev/null; then
            in_compose=true
        fi

        if ! $in_compose; then
            log_warning "[$site] Missing from docker-compose.yml"

            local php_version="$DEFAULT_PHP_VERSION"
            if [[ -f "$PROJECT_ROOT/wp_$site/wp-includes/version.php" ]]; then
                local req_php
                req_php=$(grep "required_php_version" "$PROJECT_ROOT/wp_$site/wp-includes/version.php" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1 || true)
                if [[ -n "$req_php" ]]; then
                    case "$req_php" in
                        7.*) php_version="7.4" ;;
                        8.0*) php_version="8.0" ;;
                        8.1*) php_version="8.1" ;;
                        8.2*) php_version="8.2" ;;
                        *) php_version="$DEFAULT_PHP_VERSION" ;;
                    esac
                fi
            fi

            local repair_stack="nginx"
            if [[ -f "$PROJECT_ROOT/wp_$site/.matrix-stack" ]]; then
                repair_stack=$(tr -d '[:space:]' < "$PROJECT_ROOT/wp_$site/.matrix-stack")
            fi
            case "$repair_stack" in
                apache|nginx) ;;
                *) repair_stack="nginx" ;;
            esac

            local port
            port=$(get_next_port)

            if [[ "$repair_stack" == "apache" ]]; then
                compose_add_site "$site" "$php_version" "$port" "" "apache"
                matrix_site_build_if_apache "$site" || true
                log_success "[$site] Added Apache stack to docker-compose.yml (PHP $php_version, port $port)"
            else
                if [[ ! -f "$nginx_conf" ]]; then
                    if [[ ! -d "$PROJECT_ROOT/config/nginx" ]]; then
                        mkdir -p "$PROJECT_ROOT/config/nginx"
                    fi
                    cat > "$nginx_conf" << EOF
server {
    listen 80;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php\$ {
        fastcgi_pass wp_$site:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 32k;
    }

    location ~ /\. {
        deny all;
    }
}
EOF
                fi
                compose_add_site "$site" "$php_version" "$port" "$nginx_conf" "nginx"
                log_success "[$site] Added to docker-compose.yml (PHP $php_version, port $port)"
            fi
            site_fixed=$((site_fixed + 1))
        fi

        if compose_ps_names 2>/dev/null | grep -q "wp_db"; then
            local db_exists
            db_exists=$($DOCKER_COMPOSE exec -T -e MYSQL_PWD="${MYSQL_ROOT_PASSWORD:-root}" db mysql -u root \
                -sN -e "SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME='${site}_db'" 2>/dev/null </dev/null || true)
            if [[ -z "$db_exists" ]]; then
                log_warning "[$site] Database '${site}_db' missing"
                $DOCKER_COMPOSE exec -T -e MYSQL_PWD="${MYSQL_ROOT_PASSWORD:-root}" db mysql -u root \
                    -e "CREATE DATABASE IF NOT EXISTS \`${site}_db\`; GRANT ALL PRIVILEGES ON \`${site}_db\`.* TO '${MYSQL_USER:-wp_user}'@'%'; FLUSH PRIVILEGES;" 2>/dev/null </dev/null || true
                log_success "[$site] Created database '${site}_db'"
                site_fixed=$((site_fixed + 1))
            fi
        fi

        mkdir -p "$PROJECT_ROOT/logs/wp_$site"

        if [[ $site_fixed -gt 0 ]]; then
            fixed_count=$((fixed_count + site_fixed))
        else
            log_info "[$site] OK"
        fi
    done <<< "$site_list"

    echo ""
    if [[ $fixed_count -gt 0 ]]; then
        log_success "Repair complete: $fixed_count issue(s) fixed across $checked_count site(s)"
        log_info "Run './matrix start <site>' or './matrix start' to apply changes"
    else
        log_success "All $checked_count site(s) are healthy - no issues found"
    fi
    log_activity "REPAIR" "${site_name:-all}" "$fixed_count issue(s) fixed"
}

rebuild_compose_base() {
    cat > "$COMPOSE_FILE" << 'EOF'
networks:
  wp-net:
    driver: bridge

services:
  # Database
  db:
    image: mysql:8.0
    container_name: wp_db
    restart: unless-stopped
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: wp_main
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - wp_db_data:/var/lib/mysql
    networks:
      - wp-net
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      timeout: 20s
      retries: 10

  # Cache
  redis:
    image: redis:alpine
    container_name: wp_redis
    restart: unless-stopped
    networks:
      - wp-net
    command: redis-server --maxmemory 256mb --maxmemory-policy allkeys-lru

  # Database Management
  phpmyadmin:
    image: phpmyadmin/phpmyadmin:5.2.1
    container_name: wp_phpmyadmin
    restart: unless-stopped
    ports:
      - "8200:80"
    environment:
      PMA_HOST: db
      PMA_USER: ${MYSQL_USER:-wp_user}
      PMA_PASSWORD: ${MYSQL_PASSWORD:-wp_password}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root}
    networks:
      - wp-net
    depends_on:
      - db

  # Email Testing
  mailpit:
    image: axllent/mailpit:latest
    container_name: wp_mailpit
    restart: unless-stopped
    ports:
      - "1025:1025"
      - "8025:8025"
    networks:
      - wp-net

  # Code Quality Tools
  phpcs:
    image: wpengine/phpcs:latest
    container_name: wp_phpcs
    volumes:
      - ./:/workspace:ro
    working_dir: /workspace
    networks:
      - wp-net
    profiles:
      - tools

  phpstan:
    image: ghcr.io/phpstan/phpstan:latest
    container_name: wp_phpstan
    volumes:
      - ./:/project:ro
    working_dir: /project
    networks:
      - wp-net
    profiles:
      - tools

  # Development Tools
  wp-cli:
    image: wordpress:cli
    container_name: wp_cli
    volumes:
      - ./:/var/www/html:rw
    working_dir: /var/www/html
    networks:
      - wp-net
    profiles:
      - tools
    command: ["tail", "-f", "/dev/null"]


volumes:
  wp_db_data:
EOF
}

# Main command dispatcher
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        return
    fi
    
    local command="$1"
    shift

    local json_flag=false
    local filtered_args=()
    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            json_flag=true
        else
            filtered_args+=("$arg")
        fi
    done
    if [[ "$json_flag" == true ]]; then
        JSON_OUTPUT=true
        json_log_override
    fi
    if [[ ${#filtered_args[@]} -gt 0 ]]; then
        set -- "${filtered_args[@]}"
    fi

    case "$command" in
        # --- Setup ---
        "setup")
            setup_env "$@"
            ;;
        # --- Site + environment management ---
        "start")
            if [[ -n "${1:-}" ]]; then
                local site_name="${1:-}"
                validate_site_name "$site_name" || exit 1
                if [[ ! -d "$PROJECT_ROOT/wp_${site_name}" ]]; then
                    log_error "Site '$site_name' not found"
                    exit 1
                fi

                log_info "Starting site '$site_name'..."

                # Check if site is in docker-compose.yml
                if grep -q "^  wp_${site_name}:" "$COMPOSE_FILE" 2>/dev/null; then
                    matrix_site_up "$site_name"
                else
                    local wp_container="wp_${site_name}"
                    if $CONTAINER_RUNTIME ps -a --format "{{.Names}}" 2>/dev/null | grep -q "^${wp_container}$"; then
                        $CONTAINER_RUNTIME start "$wp_container" 2>/dev/null || true
                    fi
                    if site_has_nginx "$site_name"; then
                        local nginx_container="nginx_${site_name}"
                        if $CONTAINER_RUNTIME ps -a --format "{{.Names}}" 2>/dev/null | grep -q "^${nginx_container}$"; then
                            $CONTAINER_RUNTIME start "$nginx_container" 2>/dev/null || true
                        fi
                    fi
                fi

                log_success "Site '$site_name' started"
                log_activity "START" "$site_name" "Started manually"
                show_urls "$site_name"
            else
                start_env
            fi
            ;;
        "stop")
            # Check if a site name was provided
            if [[ -n "${1:-}" ]]; then
                # Stop a specific site
                local site_name="${1:-}"
                validate_site_name "$site_name" || exit 1
                if [[ ! -d "$PROJECT_ROOT/wp_${site_name}" ]]; then
                    log_error "Site '$site_name' not found"
                    exit 1
                fi

                log_info "Stopping site '$site_name'..."
                matrix_site_stop "$site_name"
                log_success "Site '$site_name' stopped"
                log_activity "STOP" "$site_name" "Stopped manually"
            else
                # Stop entire environment
                stop_env
            fi
            ;;
        "restart")
            if [[ -n "${1:-}" ]]; then
                local site_name="${1:-}"
                validate_site_name "$site_name" || exit 1
                if [[ ! -d "$PROJECT_ROOT/wp_${site_name}" ]]; then
                    log_error "Site '$site_name' not found"
                    exit 1
                fi
                log_info "Restarting site '$site_name'..."
                matrix_site_restart "$site_name"
                log_success "Site '$site_name' restarted"
                show_urls "$site_name"
            else
                stop_env
                start_env
            fi
            ;;
        "logs")
            show_logs "$@"
            ;;
        "create")
            create_site "$@"
            ;;
        "backup")
            "$PROJECT_ROOT/scripts/backup.sh" "$@"
            ;;
        "restore")
            restore_site "$@"
            ;;
        "list"|"ls")
            if [[ "$JSON_OUTPUT" == true ]]; then
                list_sites_json
            else
                list_sites "$@"
            fi
            ;;
        "status")
            if [[ "$JSON_OUTPUT" == true ]]; then
                show_status_json
            else
                show_status "$@"
            fi
            ;;
        # --- Site lifecycle ---
        "remove"|"rm"|"delete")
            remove_site "$@"
            ;;
        "edit"|"update-site")
            edit_site "$@"
            ;;
        "clone")
            "$PROJECT_ROOT/scripts/clone.sh" "$@"
            ;;
        "reset")
            "$PROJECT_ROOT/scripts/reset.sh" "$@"
            ;;
        # --- Site operations ---
        "info")
            if [[ "$JSON_OUTPUT" == true ]]; then
                show_info_json "$@"
            else
                show_urls "$@"
            fi
            ;;
        "fix")
            log_info "Auto-fix not implemented yet"
            ;;
        "shell")
            access_shell "$@"
            ;;
        "wp"|"wp-cli")
            run_wp_cli "$@"
            ;;
        "url"|"urls")
            show_urls "$@"
            ;;
        "rest")
            rest_site "$@"
            ;;
        # --- Environment ---
        "install")
            install_env "$@"
            ;;
        "repair")
            repair_env "$@"
            ;;
        "clean")
            clean_env "$@"
            ;;
        "health")
            "$PROJECT_ROOT/scripts/health-check.sh"
            ;;
        "mail")
            if command -v open >/dev/null 2>&1; then
                open "http://$HOST_IP:8025"
            else
                echo "Open http://$HOST_IP:8025 in your browser"
            fi
            ;;
        # --- Database ---
        "import-db")
            import_db "$@"
            ;;
        "export-db")
            export_db "$@"
            ;;
        # --- Code quality ---
        "check"|"quality")
            run_checks "$@"
            ;;
        "test")
            run_checks "$@"
            ;;
        # --- Development tools ---
        "frontend")
            manage_frontend "$@"
            ;;
        "xdebug")
            configure_xdebug "$@"
            ;;
        "scaffold")
            scaffold_project "$@"
            ;;
        "preset")
            list_presets "$@"
            ;;
        "watch")
            watch_site "$@"
            ;;
        # --- Utilities ---
        "update"|"update-core")
            "$PROJECT_ROOT/scripts/update-core.sh" "$@"
            ;;
        "cache"|"cache-clear")
            "$PROJECT_ROOT/scripts/cache-clear.sh" "$@"
            ;;
        "search-replace")
            "$PROJECT_ROOT/scripts/search-replace.sh" "$@"
            ;;
        "optimize")
            optimize_site "$@"
            ;;
        "help"|"-h"|"--help")
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            show_help
            return 1
            ;;
    esac
}

main "$@"