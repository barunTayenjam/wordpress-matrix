# Get sites as array (for bash 3.2 compatibility)
get_sites_array() {
    local temp_file=$(mktemp)
    get_sites > "$temp_file"
    echo "$temp_file"
}

# Create new site
create_site() {
    local site_name=""
    local php_version="$DEFAULT_PHP_VERSION"
    local preset="blank"
    local stack="nginx"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --php-version=*)
                php_version="${1#*=}"
                shift
                ;;
            --php-version)
                php_version="$2"
                shift 2
                ;;
            --stack=*)
                stack="${1#*=}"
                shift
                ;;
            --stack)
                stack="$2"
                shift 2
                ;;
            --preset=*)
                preset="${1#*=}"
                shift
                ;;
            --preset)
                preset="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                echo "Usage: ./matrix create <name> [--php-version=X.X] [--stack=nginx|apache] [--preset=preset-name]"
                return 1
                ;;
            *)
                if [[ -z "$site_name" ]]; then
                    site_name="$1"
                fi
                shift
                ;;
        esac
    done
    
    if [[ -z "$site_name" ]]; then
        read -p "Enter site name: " site_name
    fi
    
    if [[ -z "$site_name" ]]; then
        log_error "Site name required"
        return 1
    fi
    validate_site_name "$site_name" || return 1
    
    validate_php_version "$php_version" || return 1

    case "$stack" in
        nginx|apache) ;;
        *)
            log_error "Invalid stack: $stack (use nginx or apache)"
            return 1
            ;;
    esac
    
    if site_exists "$site_name"; then
        log_error "Site '$site_name' already exists"
        return 1
    fi
    
    local site_dir="$PROJECT_ROOT/wp_$site_name"
    
    log_info "Creating WordPress site: $site_name (PHP $php_version, stack: $stack)"

    # Create directory
    mkdir -p "$site_dir"
    mkdir -p "$PROJECT_ROOT/logs/wp_$site_name"
    if [[ "$stack" == "apache" ]]; then
        echo "apache" > "$site_dir/.matrix-stack"
    else
        echo "nginx" > "$site_dir/.matrix-stack"
    fi

    # Copy WordPress files using Docker/Podman
    log_info "Installing WordPress (PHP $php_version)..."
    $CONTAINER_RUNTIME run --rm -v "$site_dir":/var/www/html wordpress:php${php_version}-fpm \
        bash -c "cp -a /usr/src/wordpress/. /var/www/html/ && chown -R www-data:www-data /var/www/html"

    # Install WP-CLI in site directory (persists via volume)
    log_info "Installing WP-CLI..."
    $CONTAINER_RUNTIME run --rm -v "$site_dir":/var/www/html wordpress:php${php_version}-fpm \
        bash -c "curl -sO https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && chmod +x wp-cli.phar && mv wp-cli.phar /var/www/html/wp && chown www-data:www-data /var/www/html/wp"

    # Copy baseline performance optimization files
    if [[ -d "$PROJECT_ROOT/config/optimizations" ]]; then
        log_info "Applying performance optimizations..."
        mkdir -p "$site_dir/wp-content/mu-plugins"
        cp "$PROJECT_ROOT/config/optimizations/perf-mu-plugin.php" "$site_dir/wp-content/mu-plugins/"
        cp "$PROJECT_ROOT/config/optimizations/object-cache.php" "$site_dir/wp-content/object-cache.php"
    fi

    # Apply preset if not blank
    if [[ "$preset" != "blank" ]]; then
        apply_preset "$site_name" "$preset"
    fi

    # Create site-specific nginx configuration (nginx stack only)
    local nginx_conf_path="$PROJECT_ROOT/config/nginx/$site_name.conf"
    if [[ "$stack" == "nginx" ]]; then
        if [[ ! -d "$PROJECT_ROOT/config/nginx" ]]; then
            mkdir -p "$PROJECT_ROOT/config/nginx"
        fi

        cat > "$nginx_conf_path" << EOF
server {
    listen 80;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php\$ {
        fastcgi_pass wp_$site_name:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
        
        # Increase buffer sizes to handle large headers
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 32k;
    }

    # Deny access to sensitive files
    location ~ /\. {
        deny all;
    }
}
EOF
    fi

    if [[ ! -f "$COMPOSE_FILE" ]]; then
        log_warning "docker-compose.yml missing - recreating base file before adding site"
        rebuild_compose_base
    fi

    port=$(get_next_port)
    compose_add_site "$site_name" "$php_version" "$port" "$nginx_conf_path" "$stack"

    # Create database and grant permissions
    if compose_or_container_running "wp_db"; then
        $CONTAINER_RUNTIME exec -e MYSQL_PWD="${MYSQL_ROOT_PASSWORD:-root}" wp_db mysql -u root \
            -e "CREATE DATABASE IF NOT EXISTS \`${site_name}_db\`; GRANT ALL PRIVILEGES ON \`${site_name}_db\`.* TO '${MYSQL_USER:-wp_user}'@'%'; FLUSH PRIVILEGES;" 2>/dev/null || true
    fi

    log_success "Site '$site_name' created successfully with PHP $php_version ($stack)"
    log_activity "CREATE" "$site_name" "Created with PHP $php_version, stack $stack, port $port"
    echo "Direct: http://$HOST_IP:$port"
    echo "Database: http://$HOST_IP:8200"

    # Auto-start the site after creation
    log_info "Starting site '$site_name'..."
    if [[ "$stack" == "apache" ]]; then
        matrix_site_build_if_apache "$site_name" || return 1
    fi
    matrix_site_up "$site_name"

    # Apply runtime performance tweaks (wp-config constants, phpredis, etc.)
    apply_performance_tweaks "$site_name" "$php_version"

    log_success "Site '$site_name' started and ready!"
    log_activity "START" "$site_name" "Auto-started after creation"
}

# Reload the PHP-FPM master process so a newly enabled extension (e.g. phpredis)
# is picked up by running workers. No-op if FPM isn't running. Finds the master
# via its args so it works whether FPM is PID 1 (official *-fpm images) or not
# (the apache stack, where apache is PID 1).
reload_fpm() {
    local container="${1:-}"
    [[ -z "$container" ]] && return 0
    $CONTAINER_RUNTIME exec "$container" bash -c '
        pid=$(ps -eo pid,args 2>/dev/null | grep "php-fpm: master" | grep -v grep | awk "{print \$1}" | head -1)
        if [ -n "$pid" ]; then
            kill -USR2 "$pid" 2>/dev/null && echo "reloaded FPM (pid $pid)"
        fi
    ' 2>/dev/null || true
}

# Apply runtime performance tweaks to a running site's container.
# Installs phpredis (if missing) and appends performance constants to
# wp-config.php.  Safe to re-run on existing sites.
apply_performance_tweaks() {
    local site="${1:-}"
    local php_version="${2:-$DEFAULT_PHP_VERSION}"
    local container="wp_$site"

    if ! $CONTAINER_RUNTIME ps --format '{{.Names}}' 2>/dev/null | grep -q "^$container$"; then
        log_warning "Container $container not running — skipping runtime tweaks"
        return 0
    fi

    # Install phpredis if missing (official Docker images don't bundle it)
    local has_redis
    has_redis=$($CONTAINER_RUNTIME exec "$container" php -m 2>/dev/null | grep -c "^redis$" || true)
    if [[ "$has_redis" -eq 0 ]]; then
        log_info "Installing phpredis in $container..."
        # phpredis >=6 needs PHP 8.x; pin the last 5.x release for PHP 7.x.
        local redis_pkg="redis"
        [[ "$php_version" == 7.* ]] && redis_pkg="redis-5.3.7"
        $CONTAINER_RUNTIME exec "$container" bash -c "
            pecl install $redis_pkg 2>/dev/null && docker-php-ext-enable redis 2>/dev/null
        " || log_warning "phpredis install failed (non-fatal)"
        # Reload FPM so the newly enabled extension is loaded by running workers.
        reload_fpm "$container"
    fi

    # Append performance constants to wp-config.php (idempotent)
    log_info "Adding performance constants to wp-config.php..."
    $CONTAINER_RUNTIME exec "$container" bash -c "
        if ! grep -q 'Matrix performance' wp-config.php 2>/dev/null; then
            cat >> wp-config.php << PHPEOF

// Matrix performance tweaks (applied by apply_performance_tweaks)
if ( ! defined( 'WP_CACHE' ) )           define( 'WP_CACHE', true );
if ( ! defined( 'WP_POST_REVISIONS' ) )   define( 'WP_POST_REVISIONS', 5 );
if ( ! defined( 'EMPTY_TRASH_DAYS' ) )    define( 'EMPTY_TRASH_DAYS', 7 );
if ( ! defined( 'DISABLE_WP_CRON' ) )     define( 'DISABLE_WP_CRON', true );
if ( ! defined( 'WP_MEMORY_LIMIT' ) )     define( 'WP_MEMORY_LIMIT', '256M' );
if ( ! defined( 'WP_MAX_MEMORY_LIMIT' ) ) define( 'WP_MAX_MEMORY_LIMIT', '512M' );
if ( ! defined( 'WP_CACHE_KEY_SALT' ) )   define( 'WP_CACHE_KEY_SALT', '$site' );
if ( ! defined( 'WP_REDIS_HOST' ) )       define( 'WP_REDIS_HOST', 'redis' );
PHPEOF
        fi
    " 2>/dev/null || log_warning "Could not update wp-config.php (container may not be fully booted)"

    log_success "Performance tweaks applied to $site"
}

# Apply performance optimizations to one or all existing sites.
# Usage: optimize_site [site-name]
optimize_site() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        log_info "Optimizing all existing sites..."
        local temp_file
        temp_file=$(get_sites_array)
        while IFS= read -r site; do
            [[ -z "$site" ]] && continue
            optimize_single_site "$site"
        done < "$temp_file"
        rm -f "$temp_file"
    else
        optimize_single_site "$target"
    fi
}

optimize_single_site() {
    local site="$1"
    local site_dir="$PROJECT_ROOT/wp_$site"

    if [[ ! -d "$site_dir" ]]; then
        log_error "Site '$site' not found at $site_dir"
        return 1
    fi

    log_info "Optimizing site: $site"

    # Copy optimization files
    if [[ -d "$PROJECT_ROOT/config/optimizations" ]]; then
        mkdir -p "$site_dir/wp-content/mu-plugins"
        cp "$PROJECT_ROOT/config/optimizations/perf-mu-plugin.php" "$site_dir/wp-content/mu-plugins/"
        cp "$PROJECT_ROOT/config/optimizations/object-cache.php" "$site_dir/wp-content/object-cache.php"
        log_success "Optimization files copied to $site"
    else
        log_warning "config/optimizations directory not found — skipping file copy"
    fi

    # Apply runtime tweaks (container must be running)
    local container="wp_$site"
    if $CONTAINER_RUNTIME ps --format '{{.Names}}' 2>/dev/null | grep -q "^$container$"; then
        # Detect PHP version from the container image
        local php_version
        php_version=$($CONTAINER_RUNTIME exec "$container" php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;' 2>/dev/null || echo "$DEFAULT_PHP_VERSION")
        apply_performance_tweaks "$site" "$php_version"
    else
        log_warning "Container $container not running — start the site to apply runtime tweaks (phpredis + wp-config constants)"
        echo "  ./matrix start $site && ./matrix optimize $site"
    fi
}

# Backup site
# Restore site
restore_site() {
    local site_name="${1:-}"
    local backup_file="${2:-}"
    
    if [[ -z "$site_name" || -z "$backup_file" ]]; then
        log_error "Usage: ./matrix restore <site-name> <backup-file>"
        return 1
    fi
    validate_site_name "$site_name" || return 1
    
    if [[ ! -f "$backup_file" ]]; then
        log_error "Backup file not found: $backup_file"
        return 1
    fi
    
    log_info "Restoring site '$site_name' from backup..."
    
    # Stop the site if running
    matrix_site_stop "$site_name"
    
    # Remove existing site
    rm -rf "$PROJECT_ROOT/wp_$site_name" 2>/dev/null || true
    
    # Extract backup
    tar -xzf "$backup_file" -C "$PROJECT_ROOT"
    
    # Start the site
    matrix_site_up "$site_name"
    
    log_success "Site '$site_name' restored"
}

list_sites_json() {
    check_docker_json

    local sites_json=""
    local first_site=true

    # Get sites via temp file (bash 3.2 compatible)
    local sites_tmp
    sites_tmp=$(mktemp)
    get_sites > "$sites_tmp"
    local site_list
    site_list=$(cat "$sites_tmp")
    rm -f "$sites_tmp"

    while IFS= read -r site || [[ -n "$site" ]]; do
        [[ -z "$site" ]] && continue
        local status="stopped"
        local port=""

        if compose_ps_names 2>/dev/null | grep -q "wp_$site"; then
            status="running"
        elif $CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | grep -q "^wp_$site$"; then
            status="running"
        fi

        port=$(get_site_port "$site")

        local php_version=""
        if [[ -f "$COMPOSE_FILE" ]]; then
            php_version=$(get_site_php_version_from_compose "$site")
        fi

        local stack
        stack=$(get_site_stack "$site")

        local container_id=""
        if [[ "$status" == "running" ]]; then
            container_id=$($CONTAINER_RUNTIME ps -q -f name="wp_$site" 2>/dev/null || true)
        fi

        local local_url="null"
        if [[ -n "$port" ]]; then
            local_url="\"http://$HOST_IP:$port\""
        fi

        local disk_usage="null"
        if [[ -d "$PROJECT_ROOT/wp_$site" ]]; then
            disk_usage="\"$(du -sh "$PROJECT_ROOT/wp_$site" 2>/dev/null | cut -f1)\""
        fi

        local php_version_json="null"
        if [[ -n "$php_version" ]]; then
            php_version_json="\"$php_version\""
        fi

        local container_id_json="null"
        if [[ -n "$container_id" ]]; then
            container_id_json="\"$container_id\""
        fi

        local site_entry="{\"name\":\"$site\",\"status\":\"$status\",\"stack\":\"$stack\",\"port\":${port:-null},\"phpVersion\":$php_version_json,\"containerId\":$container_id_json,\"localUrl\":$local_url,\"diskUsage\":$disk_usage}"

        if [[ "$first_site" == true ]]; then
            sites_json="$site_entry"
            first_site=false
        else
            sites_json="$sites_json,$site_entry"
        fi
    done <<< "$site_list"

    # Build services JSON
    local services_json=""
    local first_svc=true

    local svc_names=("wp_db:Database:null" "wp_redis:Redis Cache:null" "wp_phpmyadmin:phpMyAdmin:8200" "wp_phpcs:PHP CodeSniffer:null" "wp_phpstan:PHPStan:null" "wp_cli:WP-CLI:null")
    for svc in "${svc_names[@]}"; do
        local svc_container="${svc%%:*}"
        local remaining="${svc#*:}"
        local svc_name="${remaining%%:*}"
        local svc_port="${remaining##*:}"
        local svc_status="stopped"
        local svc_cid="null"

        if $CONTAINER_RUNTIME ps -q -f name="$svc_container" 2>/dev/null | grep -q .; then
            svc_status="running"
            svc_cid="\"$($CONTAINER_RUNTIME ps -q -f name="$svc_container" 2>/dev/null | head -1)\""
        fi

        local svc_url="null"
        if [[ "$svc_port" != "null" && -n "$svc_port" ]]; then
            svc_url="\"http://$HOST_IP:$svc_port\""
        fi

        local svc_entry="{\"name\":\"$svc_name\",\"status\":\"$svc_status\",\"containerId\":$svc_cid,\"localUrl\":$svc_url}"

        if [[ "$first_svc" == true ]]; then
            services_json="$svc_entry"
            first_svc=false
        else
            services_json="$services_json,$svc_entry"
        fi
    done

    output_json "{\"success\":true,\"sites\":[$sites_json],\"services\":[$services_json]}"
}

# Get port from running container
get_container_port() {
    local container_name="${1:-}"
    local port=""

    if [[ -z "$container_name" ]]; then
        return 1
    fi

    # Try nginx container first
    port=$($CONTAINER_RUNTIME port "$container_name" 2>/dev/null | grep '80/tcp' | head -1 | sed 's/.*://' | tr -d ' ')

    # If empty, try wp container (for apache-based sites)
    if [[ -z "$port" ]]; then
        local wp_container="${container_name/nginx_/wp_}"
        port=$($CONTAINER_RUNTIME port "$wp_container" 2>/dev/null | grep '80/tcp' | head -1 | sed 's/.*://' | tr -d ' ')
    fi

    echo "$port"
}

# List all sites and services
list_sites() {
    log_info "WordPress Sites & Services:"
    echo ""

    # Get WordPress sites - use temp file for bash 3.2 compatibility
    local sites_tmp
    sites_tmp=$(mktemp)
    get_sites > "$sites_tmp"
    local site_list
    site_list=$(cat "$sites_tmp")
    rm -f "$sites_tmp"

    # Show WordPress sites
    if [[ -n "$site_list" ]]; then
        printf "%-15s %-10s %-8s %-30s %-30s\n" "WordPress Site" "Status" "Stack" "Local URL" "Domain URL"
        echo "────────────────────────────────────────────────────────────────────────────────────"

        while IFS= read -r site || [[ -n "$site" ]]; do
            [[ -z "$site" ]] && continue
            local status="Stopped"
            local port=""
            local stack
            stack=$(get_site_stack "$site")

            if compose_or_container_running "wp_$site"; then
                status="Running"
            fi

            port=$(get_site_port "$site")

            local port_str="Not configured"
            if [[ -n "$port" ]]; then
                port_str="http://$HOST_IP:$port"
            fi
            printf "%-15s %-10s %-8s %-30s %-30s\n" "$site" "$status" "$stack" \
                "$port_str" \
                "Direct port access only"
        done <<< "$site_list"
        echo ""
    fi
    
    # Show Management Services
