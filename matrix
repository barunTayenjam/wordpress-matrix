# Show logs (newest first)
show_logs() {
    local service="${1:-}"
    local reverse_cmd="perl -e 'print reverse <>'"

    if [[ -n "$service" ]]; then
        if [[ "$service" == "db" ]]; then
            if [[ -f "$COMPOSE_FILE" ]]; then
                $DOCKER_COMPOSE logs --tail=100 "$service" | eval "$reverse_cmd"
            else
                $CONTAINER_RUNTIME logs --tail=100 wp_db 2>&1 | eval "$reverse_cmd"
            fi
        elif [[ "$service" == "nginx" ]]; then
            local nginx_containers=($(compose_ps_names | grep "^nginx_" || true))
            if [[ ${#nginx_containers[@]} -eq 0 ]]; then
                nginx_containers=($($CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | grep "^nginx_" || true))
            fi
            if [[ ${#nginx_containers[@]} -gt 0 ]]; then
                if [[ -f "$COMPOSE_FILE" ]]; then
                    $DOCKER_COMPOSE logs --tail=100 "${nginx_containers[0]}" 2>/dev/null | eval "$reverse_cmd" || \
                    $CONTAINER_RUNTIME logs --tail=100 "${nginx_containers[0]}" 2>&1 | eval "$reverse_cmd"
                else
                    $CONTAINER_RUNTIME logs --tail=100 "${nginx_containers[0]}" 2>&1 | eval "$reverse_cmd"
                fi
            else
                log_error "No nginx containers running"
            fi
        elif [[ "$service" == "redis" || "$service" == "cache" ]]; then
            if [[ -f "$COMPOSE_FILE" ]]; then
                $DOCKER_COMPOSE logs --tail=100 redis | eval "$reverse_cmd"
            else
                $CONTAINER_RUNTIME logs --tail=100 wp_redis 2>&1 | eval "$reverse_cmd"
            fi
        elif [[ "$service" == "phpmyadmin" || "$service" == "pma" ]]; then
            if [[ -f "$COMPOSE_FILE" ]]; then
                $DOCKER_COMPOSE logs --tail=100 phpmyadmin | eval "$reverse_cmd"
            else
                $CONTAINER_RUNTIME logs --tail=100 wp_phpmyadmin 2>&1 | eval "$reverse_cmd"
            fi
        else
            # Assume it's a site name
            local wp_container="wp_$service"
            local log_services
            log_services=$(compose_site_service_names "$service")

            if $DOCKER_COMPOSE logs --tail=100 $log_services 2>/dev/null | grep -q .; then
                $DOCKER_COMPOSE logs --tail=100 $log_services 2>/dev/null | eval "$reverse_cmd"
            else
                if $CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | grep -q "^${wp_container}$"; then
                    $CONTAINER_RUNTIME logs --tail=100 "$wp_container" 2>&1 | eval "$reverse_cmd"
                elif site_has_nginx "$service" && $CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | grep -q "^nginx_${service}$"; then
                    $CONTAINER_RUNTIME logs --tail=100 "nginx_${service}" 2>&1 | eval "$reverse_cmd"
                else
                    log_error "No containers found for site: $service"
                fi
            fi
        fi
    else
        if [[ -f "$COMPOSE_FILE" ]]; then
            $DOCKER_COMPOSE logs --tail=100 | eval "$reverse_cmd"
        else
            $CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | while read -r container; do
                [[ -z "$container" ]] && continue
                echo "==> $container <=="
                $CONTAINER_RUNTIME logs --tail=50 "$container" 2>&1 || true
            done | eval "$reverse_cmd"
        fi
    fi
}

# Remove site
remove_site() {
    local site_name="${1:-}"
    local force_yes="${2:-}"

    validate_site_name "$site_name" || return 1

    if ! site_exists "$site_name"; then
        log_error "Site '$site_name' not found"
        return 1
    fi

    if [[ "$force_yes" != "--yes" && "$force_yes" != "-y" ]]; then
        echo -e "${RED}WARNING: This will permanently delete '$site_name'${NC}"
        read -p "Continue? [y/N]: " confirm

        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            log_info "Cancelled"
            return
        fi
    fi

    log_info "Removing site '$site_name'..."

    # Stop services
    matrix_site_stop "$site_name"
    matrix_site_rm_containers "$site_name"
    $CONTAINER_RUNTIME ps -a --filter name="$site_name" --format '{{.Names}}' 2>/dev/null | while read -r c; do
        $CONTAINER_RUNTIME rm -f "$c" 2>/dev/null || true
    done

    # Remove files
    rm -rf "$PROJECT_ROOT/wp_$site_name"
    rm -rf "$PROJECT_ROOT/logs/wp_$site_name"

    # Remove database
    if compose_or_container_running "wp_db"; then
        $CONTAINER_RUNTIME exec -e MYSQL_PWD="${MYSQL_ROOT_PASSWORD:-root}" wp_db mysql -u root \
            -e "DROP DATABASE IF EXISTS \`${site_name}_db\`; REVOKE ALL PRIVILEGES ON \`${site_name}_db\`.* FROM '${MYSQL_USER:-wp_user}'@'%'; FLUSH PRIVILEGES;" 2>/dev/null || true
    fi

    compose_remove_site "$site_name"

    # Remove from .env file
    if [[ -f "$PROJECT_ROOT/.env" ]]; then
        local env_var_name=$(echo "$site_name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
        local temp_env=$(mktemp)
        grep -v "^${env_var_name}_PORT=" "$PROJECT_ROOT/.env" > "$temp_env"
        # Also remove the comment line that identifies the site
        grep -v "^# Site: $site_name" "$temp_env" > "$PROJECT_ROOT/.env"
        rm -f "$temp_env"
    fi

    log_success "Site '$site_name' removed"
    log_activity "REMOVE" "$site_name" "Site removed"
}

# Edit site configuration
edit_site() {
    local site_name=""
    local new_php_version=""
    local new_port=""
    local new_memory=""
    local new_cpu=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --php-version=*)
                new_php_version="${1#*=}"
                shift
                ;;
            --php-version)
                new_php_version="$2"
                shift 2
                ;;
            --port=*)
                new_port="${1#*=}"
                shift
                ;;
            --port)
                new_port="$2"
                shift 2
                ;;
            --memory=*)
                new_memory="${1#*=}"
                shift
                ;;
            --memory)
                new_memory="$2"
                shift 2
                ;;
            --cpu=*)
                new_cpu="${1#*=}"
                shift
                ;;
            --cpu)
                new_cpu="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                echo "Usage: ./matrix edit <name> [--php-version=X.X] [--port=XXXX] [--memory=512M] [--cpu=0.5]"
                return 1
                ;;
            *)
                if [[ -z "$site_name" ]]; then
                    site_name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$site_name" ]]; then
        log_error "Usage: ./matrix edit <name> [--php-version=X.X] [--port=XXXX] [--memory=512M] [--cpu=0.5]"
        return 1
    fi
    validate_site_name "$site_name" || return 1

    if ! site_exists "$site_name"; then
        log_error "Site '$site_name' not found"
        return 1
    fi

    local has_changes=false

    if [[ -n "$new_php_version" ]]; then
        validate_php_version "$new_php_version" || return 1
    fi

    # Validate port if provided
    if [[ -n "$new_port" ]]; then
        if ! [[ "$new_port" =~ ^[0-9]+$ ]] || [[ "$new_port" -lt 1024 ]] || [[ "$new_port" -gt 65535 ]]; then
            log_error "Invalid port: $new_port. Must be between 1024 and 65535"
            return 1
        fi
    fi

    # Validate memory if provided
    if [[ -n "$new_memory" ]]; then
        if ! [[ "$new_memory" =~ ^[0-9]+[MmGg]$ ]]; then
            log_error "Invalid memory: $new_memory. Use format like 512M or 1G"
            return 1
        fi
    fi

    # Validate CPU if provided
    if [[ -n "$new_cpu" ]]; then
        if ! [[ "$new_cpu" =~ ^[0-9]*\.?[0-9]+$ ]]; then
            log_error "Invalid CPU: $new_cpu. Use format like 0.5 or 1.0"
            return 1
        fi
    fi

    # Get current PHP version from docker-compose.yml
    local current_php_version=""
    if [[ -f "$COMPOSE_FILE" ]] && grep -q "wp_$site_name:" "$COMPOSE_FILE"; then
        current_php_version=$(get_site_php_version_from_compose "$site_name")
        [[ -n "$current_php_version" ]] && current_php_version="php${current_php_version}"
    fi

    # Get current port from docker-compose.yml
    local current_port=""
    if [[ -f "$COMPOSE_FILE" ]]; then
        current_port=$(get_site_port_from_compose "$site_name")
    fi

    # Get current resources
    local current_memory=""
    local current_cpu=""
    local current_nginx_memory=""
    local current_nginx_cpu=""
    if [[ -f "$COMPOSE_FILE" ]]; then
        current_memory=$(grep -A 20 "wp_$site_name:" "$COMPOSE_FILE" | grep "mem_limit:" | head -1 | awk '{print $2}' || true)
        current_cpu=$(grep -A 20 "wp_$site_name:" "$COMPOSE_FILE" | grep "^[[:space:]]*cpus:" | head -1 | awk '{print $2}' || true)
        current_nginx_memory=$(grep -A 20 "nginx_$site_name:" "$COMPOSE_FILE" | grep "mem_limit:" | head -1 | awk '{print $2}' || true)
        current_nginx_cpu=$(grep -A 20 "nginx_$site_name:" "$COMPOSE_FILE" | grep "^[[:space:]]*cpus:" | head -1 | awk '{print $2}' || true)
    fi

    if [[ -z "$current_php_version" && -z "$new_port" && -z "$new_memory" && -z "$new_cpu" ]]; then
        log_error "Site '$site_name' is not configured in docker-compose.yml"
        return 1
    fi

    if [[ -f "$COMPOSE_FILE" ]]; then
        if [[ -n "$new_php_version" ]]; then
            compose_edit_php_version "$site_name" "$new_php_version" || return 1
        fi

        if [[ -n "$new_port" ]]; then
            compose_edit_port "$site_name" "$new_port" || return 1
        fi

        if [[ -n "$new_memory" ]]; then
            compose_edit_memory "$site_name" "$new_memory" || return 1
        fi

        if [[ -n "$new_cpu" ]]; then
            compose_edit_cpu "$site_name" "$new_cpu" || return 1
        fi
    fi

    # Report changes
    if [[ -n "$new_php_version" ]]; then
        log_info "PHP version: $current_php_version -> php$new_php_version"
        has_changes=true
    fi
    if [[ -n "$new_port" ]]; then
        log_info "Port: $current_port -> $new_port"
        has_changes=true
    fi
    if [[ -n "$new_memory" ]]; then
        if site_has_nginx "$site_name"; then
            local nginx_mem
            nginx_mem=$(echo "$new_memory" | sed 's/^\([0-9]*\).*/\1/')
            local nginx_mem_unit=$(echo "$new_memory" | sed 's/^[0-9]*//I')
            if [[ "$nginx_mem_unit" == "G" || "$nginx_mem_unit" == "g" ]]; then
                nginx_mem=$((nginx_mem / 2))
                [[ $nginx_mem -lt 128 ]] && nginx_mem=128
                nginx_mem="${nginx_mem}m"
            elif [[ "$nginx_mem_unit" == "M" || "$nginx_mem_unit" == "m" ]]; then
                nginx_mem=$((nginx_mem / 2))
                [[ $nginx_mem -lt 128 ]] && nginx_mem=128
                nginx_mem="${nginx_mem}m"
            else
                nginx_mem="128m"
            fi
            log_info "Memory: PHP-FPM ${new_memory}, nginx ${nginx_mem}"
        else
            log_info "Memory: Apache/PHP-FPM ${new_memory}"
        fi
        has_changes=true
    fi
    if [[ -n "$new_cpu" ]]; then
        if site_has_nginx "$site_name"; then
            local nginx_cpu
            nginx_cpu=$(echo "$new_cpu" | awk '{print $1/2}')
            [[ $(echo "$nginx_cpu < 0.25" | bc -l 2>/dev/null || echo 0) -eq 1 ]] && nginx_cpu=0.25
            log_info "CPU: PHP-FPM ${new_cpu}, nginx ${nginx_cpu}"
        else
            log_info "CPU: Apache/PHP-FPM ${new_cpu}"
        fi
        has_changes=true
    fi

    if ! $has_changes; then
        echo "Current configuration for '$site_name':"
        [[ -n "$current_php_version" ]] && echo "  PHP version: $current_php_version"
        [[ -n "$current_port" ]] && echo "  Port: $current_port (http://$HOST_IP:$current_port)"
        echo ""
        echo "Usage: ./matrix edit $site_name [--php-version=X.X] [--port=XXXX]"
        return 0
    fi

    # Restart the site if it was running
    if compose_or_container_running "wp_$site_name"; then
        log_info "Restarting site '$site_name' to apply changes..."
        if [[ -n "$new_php_version" && "$(get_site_stack "$site_name")" == "apache" ]]; then
            matrix_site_build_if_apache "$site_name" || return 1
        fi
        matrix_site_restart "$site_name"
        log_success "Site restarted"
    fi

    log_success "Site '$site_name' updated"
    log_activity "EDIT" "$site_name" "Updated configuration"
}

# Run a tool container with compose --profile, falling back to direct run for podman
run_tool_container() {
    local service="${1:-}"

    if [[ -z "$service" ]]; then
        log_error "Usage: ./matrix check <site> [path] or ./matrix run-tool <tool-name>"
        return 1
    fi
    shift
    if $DOCKER_COMPOSE --profile tools run --rm "$service" "$@" 2>/dev/null; then
        return 0
    fi
    local db_network
    db_network=$(get_db_network)
    local network_args=()
    if [[ -n "$db_network" ]]; then
        network_args=(--network "$db_network")
    fi
    case "$service" in
        phpcs)
            $CONTAINER_RUNTIME run --rm -v "$PROJECT_ROOT":/workspace:ro -w /workspace "${network_args[@]}" \
                wpengine/phpcs:latest "$@"
            ;;
        phpstan)
            $CONTAINER_RUNTIME run --rm -v "$PROJECT_ROOT":/project:ro -w /project "${network_args[@]}" \
                ghcr.io/phpstan/phpstan:latest "$@"
            ;;
        wp-cli)
            $CONTAINER_RUNTIME run --rm -v "$PROJECT_ROOT":/var/www/html:rw -w /var/www/html "${network_args[@]}" \
                wordpress:cli "$@"
            ;;
        *)
            log_error "Unknown tool service: $service"
            return 1
            ;;
    esac
}

# Code quality checks
run_checks() {
    local site_name="${1:-}"
    local specific_path="${2:-}"
    local target_paths=""
    
    if [[ -n "$site_name" ]]; then
        validate_site_name "$site_name" || return 1
        local site_dir="wp_${site_name}"
        if [[ ! -d "$site_dir" ]]; then
            log_error "Site '$site_name' not found (directory: $site_dir)"
            return 1
        fi
        
        if [[ -n "$specific_path" ]]; then
            target_paths="./${site_dir}/${specific_path}"
            log_info "Running code quality checks on: $site_name/$specific_path"
        else
            target_paths="./${site_dir}/wp-content/themes/ ./${site_dir}/wp-content/plugins/"
            log_info "Running code quality checks on site: $site_name"
            log_info "Excluding default WordPress themes, vendor, and common plugins"
        fi
    else
        target_paths="./wp_*/wp-content/themes/ ./wp_*/wp-content/plugins/"
        log_info "Running code quality checks on all sites..."
        log_info "Excluding default WordPress themes, vendor, and common plugins"
    fi
    
    # Check if code quality containers exist in $DOCKER_COMPOSE
    if ! grep -q "phpcs" "$COMPOSE_FILE" 2>/dev/null; then
        log_warning "Code quality tools not configured"
        return
    fi
    
    # Build exclude patterns for default/third-party themes and plugins
    local exclude_patterns=""
    exclude_patterns="$exclude_patterns --ignore=*/vendor/*"
    exclude_patterns="$exclude_patterns --ignore=*/node_modules/*"
    exclude_patterns="$exclude_patterns --ignore=*/.git/*"
    exclude_patterns="$exclude_patterns --ignore=*/tests/*"
    exclude_patterns="$exclude_patterns --ignore=*/twentytwenty*/*"
    exclude_patterns="$exclude_patterns --ignore=*/twenty*/*"
    exclude_patterns="$exclude_patterns --ignore=*/index.php"
    exclude_patterns="$exclude_patterns --ignore=*/akismet/*"
    exclude_patterns="$exclude_patterns --ignore=*/hello.php"
    exclude_patterns="$exclude_patterns --ignore=*/advanced-custom-fields*/*"
    exclude_patterns="$exclude_patterns --ignore=*/elementor/*"
    exclude_patterns="$exclude_patterns --ignore=*/wordpress-seo/*"
    exclude_patterns="$exclude_patterns --ignore=*/redirection/*"
    exclude_patterns="$exclude_patterns --ignore=*/litespeed-cache/*"
    exclude_patterns="$exclude_patterns --ignore=*/better-search-replace/*"
    exclude_patterns="$exclude_patterns --ignore=*/defender*/*"
    exclude_patterns="$exclude_patterns --ignore=*/sg-security/*"
    exclude_patterns="$exclude_patterns --ignore=*/duplicate-page/*"
    exclude_patterns="$exclude_patterns --ignore=*/really-simple-ssl/*"
    exclude_patterns="$exclude_patterns --ignore=*/classic-elementor*/*"
    exclude_patterns="$exclude_patterns --ignore=*/revslider/*"
    exclude_patterns="$exclude_patterns --ignore=*/export-posts*/*"
    exclude_patterns="$exclude_patterns --ignore=*/csv-taxonomy*/*"
    exclude_patterns="$exclude_patterns --ignore=*/wp-file-manager/*"
    
    # Run PHP CodeSniffer
    log_info "Running PHP CodeSniffer..."
    run_tool_container phpcs \
        -d memory_limit=512M \
        --standard=WordPress \
        --extensions=php \
        $exclude_patterns \
        $target_paths 2>/dev/null || \
    log_warning "PHP CodeSniffer check completed with issues"
    
    # Run PHPStan (only on custom code to avoid timeout)
    if [[ -n "$specific_path" ]]; then
        log_info "Running PHPStan..."
        run_tool_container phpstan analyse \
            --memory-limit=512M \
            $target_paths --level=5 2>/dev/null || \
        log_warning "PHPStan check completed with issues"
    else
        log_info "Skipping PHPStan (use specific path to run PHPStan: ./matrix check <site> <path>)"
    fi
    
    log_info "Code quality checks completed"
}

# Access shell
access_shell() {
    local service="${1:-}"

    if [[ -z "$service" ]]; then
        log_error "Usage: ./matrix shell <service>"
        log_info "Available: wp, db, nginx"
        return 1
    fi

    local exec_flags=("-it")
    if [[ ! -t 0 ]]; then
        exec_flags=("-i")
    fi

    case "$service" in
        "wp"|"wordpress")
            # Get running WordPress containers (exclude db, redis, and other services)
            local running_containers=($($CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | grep "^wp_" | grep -vE "wp_db|wp_redis|wp_phpmyadmin|wp_phpcs|wp_phpstan|wp_cli" || true))
            if [[ ${#running_containers[@]} -eq 0 ]]; then
                log_error "No WordPress containers running"
                return 1
            fi
            
            # Use first running WordPress container
            local container_name="${running_containers[0]}"
            echo "Accessing container: $container_name"
            $CONTAINER_RUNTIME exec "${exec_flags[@]}" "$container_name" bash || {
                log_error "Failed to access WordPress container"
                return 1
            }
            ;;
        "db"|"database")
            $CONTAINER_RUNTIME exec "${exec_flags[@]}" -e MYSQL_PWD="${MYSQL_ROOT_PASSWORD:-root}" wp_db mysql -u root
            ;;
        "nginx"|"proxy")
            local nginx_containers=($($CONTAINER_RUNTIME ps --format "{{.Names}}" 2>/dev/null | grep "^nginx_" || true))
            if [[ ${#nginx_containers[@]} -eq 0 ]]; then
                log_error "No nginx containers running"
                return 1
            fi
            
            # Use first running nginx container
            local container_name="${nginx_containers[0]}"
            echo "Accessing container: $container_name"
            $CONTAINER_RUNTIME exec "${exec_flags[@]}" "$container_name" sh || {
                log_error "Failed to access nginx container"
                return 1
            }
            ;;
        *)
            log_error "Unknown service: $service"
            echo "Available: wp, db, nginx"
            return 1
            ;;
    esac
}

show_info_json() {
    local site_name="${1:-}"

    if [[ -z "$site_name" ]]; then
        error_json "INVALID_NAME" "Site name is required"
    fi
    if ! validate_site_name "$site_name" >/dev/null 2>&1; then
        error_json "INVALID_NAME" "Invalid site name"
    fi

    if ! site_exists "$site_name"; then
        error_json "SITE_NOT_FOUND" "Site '$site_name' does not exist"
    fi

    check_docker_json

    local status="stopped"
    if compose_or_container_running "wp_$site_name"; then
        status="running"
    fi

    local port=""
    if [[ -f "$COMPOSE_FILE" ]]; then
        port=$(get_site_port_from_compose "$site_name")
    fi
    if [[ -z "$port" ]]; then
        port=$(get_site_port "$site_name")
    fi

    local php_version=""
    if [[ -f "$COMPOSE_FILE" ]]; then
        php_version=$(get_site_php_version_from_compose "$site_name")
    fi

    local stack
    stack=$(get_site_stack "$site_name")

    local container_id=""
    if [[ "$status" == "running" ]]; then
        container_id=$($CONTAINER_RUNTIME ps -q -f name="wp_$site_name" 2>/dev/null || true)
    fi

    local local_url="null"
    if [[ -n "$port" ]]; then
        local_url="\"http://$HOST_IP:$port\""
    fi

    local db_name="${site_name}_db"

    local db_size="null"
    if [[ "$status" == "running" ]]; then
        db_size=$($CONTAINER_RUNTIME exec -e MYSQL_PWD="${MYSQL_ROOT_PASSWORD:-root}" wp_db mysql -u root -sN -e "SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) FROM information_schema.tables WHERE table_schema='${site_name}_db'" 2>/dev/null || true)
        if [[ -n "$db_size" && "$db_size" != "NULL" ]]; then
            db_size="$db_size"
        else
            db_size="null"
        fi
    fi

    local disk_usage="null"
    if [[ -d "$PROJECT_ROOT/wp_$site_name" ]]; then
        disk_usage="\"$(du -sh "$PROJECT_ROOT/wp_$site_name" 2>/dev/null | cut -f1)\""
    fi

    local nginx_config="null"
    if [[ "$stack" == "nginx" ]]; then
        nginx_config="\"config/nginx/$site_name.conf\""
    fi

    local wp_version="null"
    if [[ -f "$PROJECT_ROOT/wp_$site_name/wp-includes/version.php" ]]; then
        wp_version=$(grep "wp_version =" "$PROJECT_ROOT/wp_$site_name/wp-includes/version.php" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)
        if [[ -n "$wp_version" ]]; then
            wp_version="\"$wp_version\""
        else
            wp_version="null"
        fi
    fi

    local php_version_json="null"
    if [[ -n "$php_version" ]]; then
        php_version_json="\"$php_version\""
    fi

    local container_id_json="null"
    if [[ -n "$container_id" ]]; then
        container_id_json="\"$container_id\""
    fi

    output_json "{\"success\":true,\"site\":{\"name\":\"$site_name\",\"status\":\"$status\",\"stack\":\"$stack\",\"port\":${port:-null},\"phpVersion\":$php_version_json,\"containerId\":$container_id_json,\"localUrl\":$local_url,\"dbName\":\"$db_name\",\"dbSize\":$db_size,\"diskUsage\":$disk_usage,\"nginxConfigPath\":$nginx_config,\"wordpressVersion\":$wp_version}}"
}

