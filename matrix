        "WordPress Command Line"
    
    echo ""
}

# Start environment
start_env() {
    log_info "Starting WordPress environment..."
    $DOCKER_COMPOSE up -d db redis phpmyadmin 2>/dev/null || true
    sleep 3

    # Start frontend if available
    if [[ -d "$PROJECT_ROOT/frontend" ]]; then
        manage_frontend start
    fi

    log_success "Environment started"
    echo ""
    echo "Core services running: database, redis, phpMyAdmin"
    echo ""
    echo "Start sites individually: ./matrix start <site>"
    
    # Show frontend URL
    if [[ -f "$PROJECT_ROOT/.frontend.pid" ]]; then
        local pid=$(cat "$PROJECT_ROOT/.frontend.pid")
        if ps -p "$pid" > /dev/null 2>&1; then
            echo "Frontend: http://$HOST_IP:8500"
        fi
    fi
}

# Stop environment
stop_env() {
    log_info "Stopping WordPress environment..."
    
    # Stop frontend first if running
    if [[ -d "$PROJECT_ROOT/frontend" ]]; then
        manage_frontend stop
    fi
    
    $DOCKER_COMPOSE down
    log_success "Environment stopped"
}

show_status_json() {
    check_docker_json

    local containers_json=""
    local first=true

    local compose_output
    compose_output=$($CONTAINER_RUNTIME ps --format "{{.Names}}\t{{.Status}}\t{{.Ports}}" 2>&1) || {
        error_json "DOCKER_ERROR" "Failed to query Docker: $compose_output"
    }

    while IFS=$'\t' read -r name status ports; do
        [[ -z "$name" ]] && continue
        [[ "$name" =~ ^wordpress-matrix ]] && continue
        
        local name_json="${name//\"/\\\"}"
        local status_json="${status//\"/\\\"}"
        local ports_json="${ports//\"/\\\"}"

        local entry="{\"name\":\"$name_json\",\"status\":\"$status_json\",\"ports\":\"$ports_json\"}"

        if [[ "$first" == true ]]; then
            containers_json="$entry"
            first=false
        else
            containers_json="$containers_json,$entry"
        fi
    done <<< "$compose_output"

    # Frontend status
    local fe_status="stopped"
    local fe_pid="null"
    local fe_url="null"
    if [[ -f "$PROJECT_ROOT/.frontend.pid" ]]; then
        local pid=$(cat "$PROJECT_ROOT/.frontend.pid")
        if ps -p "$pid" > /dev/null 2>&1; then
            fe_status="running"
            fe_pid="$pid"
            fe_url="\"http://$HOST_IP:8500\""
        fi
    fi

    output_json "{\"success\":true,\"containers\":[$containers_json],\"frontend\":{\"name\":\"frontend\",\"status\":\"$fe_status\",\"pid\":$fe_pid,\"url\":$fe_url}}"
}

