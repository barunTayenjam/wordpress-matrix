        redis_status="Running"
    fi
    printf "%-15s %-10s %-30s %-30s\n" "Redis Cache" "$redis_status" \
        "Internal" \
        "In-memory Cache"
    
    # phpMyAdmin
    local phpmyadmin_status="Stopped"
    if compose_or_container_running "wp_phpmyadmin"; then
        phpmyadmin_status="Running"
    fi
    printf "%-15s %-10s %-30s %-30s\n" "phpMyAdmin" "$phpmyadmin_status" \
        "http://$HOST_IP:8200" \
        "Database Management"

    # Mailpit
    local mailpit_status="Stopped"
    if compose_or_container_running "wp_mailpit"; then
        mailpit_status="Running"
    fi
    printf "%-15s %-10s %-30s %-30s\n" "Mailpit" "$mailpit_status" \
        "http://$HOST_IP:8025" \
        "Email Testing (SMTP: 1025)"


    # Code Quality Tools
    local phpcs_status="Stopped"
    if compose_or_container_running "wp_phpcs"; then
        phpcs_status="Running"
    fi
    printf "%-15s %-10s %-30s %-30s\n" "PHP CodeSniffer" "$phpcs_status" \
        "Tools Profile" \
        "Code Quality - WordPress Standards"
    
    local phpstan_status="Stopped"
    if compose_or_container_running "wp_phpstan"; then
        phpstan_status="Running"
    fi
    printf "%-15s %-10s %-30s %-30s\n" "PHPStan" "$phpstan_status" \
        "Tools Profile" \
        "Code Quality - Static Analysis"
    
    local wpcli_status="Stopped"
    if compose_or_container_running "wp_cli"; then
        wpcli_status="Running"
    fi
    printf "%-15s %-10s %-30s %-30s\n" "WP-CLI" "$wpcli_status" \
