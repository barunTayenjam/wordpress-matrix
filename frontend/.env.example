# Frontend Environment Configuration

# Server Configuration
PORT=8500

# Matrix Command Path (relative to parent directory)
MATRIX_PATH=../matrix

# Security
ALLOWED_COMMANDS=start,stop,restart,status,logs,clean,check
ALLOWED_SITE_COMMANDS=create,start,stop,remove,info,url

# Frontend Settings
NODE_ENV=development
LOG_LEVEL=info

# LAN access: without this token the dashboard binds to 127.0.0.1 only.
# Set a token to bind 0.0.0.0 and require Authorization: Bearer <token> on /api/*.
#   MATRIX_DASHBOARD_TOKEN=<output of: openssl rand -hex 16>
MATRIX_DASHBOARD_TOKEN=
