<div class="tab-panels">
  <!-- Dashboard Panel -->
  <div class="tab-panel active" id="panel-dashboard" role="tabpanel" aria-labelledby="tab-dashboard">
    <!-- Live Status Bar -->
    <div class="status-bar-live" id="liveStatusBar">
      <div class="pill running">
        <span class="pulse-dot"></span>
        <span id="liveRunning">0</span> running
      </div>
      <div class="pill stopped">
        <span class="dot"></span>
        <span id="liveStopped">0</span> stopped
      </div>
      <div class="pill active">
        <span class="pulse-dot"></span>
        <span id="liveServices">0</span> services
      </div>
      <div class="pill muted">
        <i class="ph-light ph-clock"></i>
        Last: <span id="lastUpdateDisplay">--</span>
      </div>
    </div>

    <!-- Bento Stats Grid -->
    <div class="bento-grid">
      <div class="bento-cell cell-total reveal">
        <div class="shell">
          <div class="inner">
            <div class="stat-header">
              <div class="stat-icon-box primary">
                <i class="ph-light ph-hard-drives"></i>
              </div>
              <span class="stat-badge">all time</span>
            </div>
            <div class="stat-body">
              <span class="stat-value" id="totalSitesCount">{{sites.length}}</span>
              <span class="stat-label">Total Sites</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bento-cell cell-running reveal">
        <div class="shell">
          <div class="inner">
            <div class="stat-header">
              <div class="stat-icon-box success">
                <i class="ph-light ph-play-circle"></i>
              </div>
              <span class="stat-badge">online</span>
            </div>
            <div class="stat-body">
              <span class="stat-value" id="runningSitesCount">{{runningSitesCount}}</span>
              <span class="stat-label">Running</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bento-cell cell-services reveal">
        <div class="shell">
          <div class="inner">
            <div class="stat-header">
              <div class="stat-icon-box accent">
                <i class="ph-light ph-stack"></i>
              </div>
              <span class="stat-badge">active</span>
            </div>
            <div class="stat-body">
              <span class="stat-value" id="servicesCount">{{services.length}}</span>
              <span class="stat-label">Services</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Full Quick Actions Panel -->
    <div class="section-panel reveal">
      <div class="shell">
        <div class="inner">
          <div class="panel-header">
            <div class="panel-title">
              <i class="ph-light ph-lightning"></i>
              <span>Quick Actions</span>
            </div>
          </div>
          <div class="panel-body">
            <div class="action-strip">
              <button class="action-btn primary" onclick="quickAction('start')">
                <span class="btn-inner">
                  <span>Start All</span>
                  <span class="btn-icon-wrap"><i class="ph-light ph-play"></i></span>
                </span>
              </button>
              <button class="action-btn secondary" onclick="quickAction('stop')">
                <span class="btn-inner">
                  <span>Stop All</span>
                  <span class="btn-icon-wrap"><i class="ph-light ph-stop"></i></span>
                </span>
              </button>
              <button class="action-btn outline" onclick="quickAction('restart')">
                <span class="btn-inner">
                  <span>Restart</span>
                  <span class="btn-icon-wrap"><i class="ph-light ph-arrows-clockwise"></i></span>
                </span>
              </button>
              <button class="action-btn outline" onclick="quickAction('check')">
                <span class="btn-inner">
                  <span>Code Quality</span>
                  <span class="btn-icon-wrap"><i class="ph-light ph-clipboard-text"></i></span>
                </span>
              </button>
              <button class="action-btn outline danger" onclick="quickAction('clean')">
                <span class="btn-inner">
                  <span>Clean</span>
                  <span class="btn-icon-wrap"><i class="ph-light ph-trash"></i></span>
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sites Panel -->
  <div class="tab-panel" id="panel-sites" role="tabpanel" aria-labelledby="tab-sites">
    <div class="panel-header between">
      <div class="panel-title">
        <i class="ph-light ph-hard-drives"></i>
        <span>Sites</span>
      </div>
      <button class="action-btn outline" onclick="openModal('importBundleModal')">
        <span class="btn-inner">
          <span>Import Bundle</span>
          <span class="btn-icon-wrap"><i class="ph-light ph-package"></i></span>
        </span>
      </button>
      <button class="action-btn primary" onclick="openModal('createSiteModal'); loadPresetOptions();">
        <span class="btn-inner">
          <span>New Site</span>
          <span class="btn-icon-wrap"><i class="ph-light ph-plus"></i></span>
        </span>
      </button>
    </div>

    <div class="section-panel">
      <div class="shell">
        <div class="inner">
          <div class="filter-strip">
            <div class="filter-field">
              <i class="ph-light ph-magnifying-glass"></i>
              <input type="search" id="siteSearch" placeholder="Search sites..." class="filter-input" aria-label="Search sites">
            </div>
            <div class="filter-select">
              <select id="siteStatusFilter" aria-label="Filter sites by status">
                <option value="all">All statuses</option>
                <option value="running">Running</option>
                <option value="stopped">Stopped</option>
              </select>
            </div>
            <div class="filter-select">
              <select id="siteSort" aria-label="Sort sites">
                <option value="name-asc">Name A-Z</option>
                <option value="name-desc">Name Z-A</option>
                <option value="status">Status</option>
                <option value="php">PHP version</option>
              </select>
            </div>
            <button class="filter-reset" onclick="resetSiteFilters()" aria-label="Reset filters">
              <i class="ph-light ph-x-circle"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="sites-grid" id="sitesGrid">
      {{#each sites}}
      <div class="site-card double-bezel reveal" data-site-name="{{name}}" data-site-status="{{status}}" data-site-php="{{phpVersion}}" data-site-url="{{localUrl}}">
        <div class="shell">
          <div class="inner">
            <div class="site-card-top">
              <h3 class="site-name">{{name}}</h3>
              <span class="status-tag {{#if (eq status "Running")}}live{{else}}down{{/if}}">
                <span class="status-tag-dot"></span>
                {{status}}
              </span>
            </div>
            {{#if localUrl}}
            <div class="site-meta">
              <i class="ph-light ph-link"></i>
              <a href="{{localUrl}}" target="_blank" rel="noopener">{{localUrl}}</a>
            </div>
            <div class="site-actions">
              <a href="{{localUrl}}" target="_blank" rel="noopener" class="action-chip small">
                <i class="ph-light ph-arrow-square-out"></i> Open
              </a>
              <button class="action-chip small" onclick="checkSiteHealth(this.closest('.site-card').dataset.siteName)">
                <i class="ph-light ph-heartbeat"></i> Health
              </button>
            </div>
            <div id="health-{{name}}" class="health-result" style="display:none">
              <span class="health-text"></span>
            </div>
            {{else}}
            <div class="site-meta muted">
              <i class="ph-light ph-info"></i>
              <span>Not configured</span>
            </div>
            {{/if}}
            <div class="site-toolbar">
              <div class="toolbar-group">
                <button class="toolbar-btn" onclick="siteAction('start', this.closest('.site-card').dataset.siteName)" title="Start {{name}}">
                  <i class="ph-light ph-play"></i>
                  <span>Start</span>
                </button>
                <button class="toolbar-btn" onclick="siteAction('stop', this.closest('.site-card').dataset.siteName)" title="Stop {{name}}">
                  <i class="ph-light ph-stop"></i>
                  <span>Stop</span>
                </button>
                <button class="toolbar-btn" onclick="siteAction('restart', this.closest('.site-card').dataset.siteName)" title="Restart {{name}}">
                  <i class="ph-light ph-arrows-clockwise"></i>
                  <span>Restart</span>
                </button>
                <button class="toolbar-btn" onclick="runChecksForSite(this.closest('.site-card').dataset.siteName)" title="Run checks on {{name}}">
                  <i class="ph-light ph-clipboard-text"></i>
                  <span>Check</span>
                </button>
                <button class="toolbar-btn" onclick="siteAction('backup', this.closest('.site-card').dataset.siteName)" title="Backup {{name}}">
                  <i class="ph-light ph-download"></i>
                  <span>Backup</span>
                </button>
              </div>
              <div class="dropdown-container">
                <button class="toolbar-btn" onclick="toggleDropdown(event, this.closest('.site-card').dataset.siteName)" title="More actions for {{name}}" aria-expanded="false" aria-controls="dropdown-{{name}}">
                  <i class="ph-light ph-dots-three-vertical"></i>
                  <span>More</span>
                </button>
                <div class="dropdown-menu" id="dropdown-{{name}}">
                  <button onclick="siteAction('info', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-info"></i>Info</button>
                  <button onclick="siteAction('url', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-link"></i>URL</button>
                  <button onclick="siteAction('logs', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-terminal"></i>Logs</button>
                  <button onclick="siteAction('edit', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-pencil"></i>Edit</button>
                  <div class="dropdown-divider"></div>
                  <button onclick="siteAction('export-db', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-export"></i>Export DB</button>
                  <button onclick="siteAction('import-db', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-download-simple"></i>Import DB</button>
                  <button onclick="siteAction('restore', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-arrow-counter-clockwise"></i>Restore</button>
                  <div class="dropdown-divider"></div>
                  <button onclick="siteAction('clone', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-copy"></i>Clone</button>
                  <button class="warning" onclick="siteAction('reset', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-warning"></i>Reset</button>
                  <button class="danger" onclick="siteAction('remove', this.closest('.site-card').dataset.siteName)"><i class="ph-light ph-trash"></i>Delete</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    <div class="empty-state" id="sitesEmptyState" style="display:none">
      <div class="shell">
        <div class="inner">
          <i class="ph-light ph-hard-drives" style="font-size:2rem;opacity:0.3"></i>
          <p>No sites match current filters</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Services Panel -->
  <div class="tab-panel" id="panel-services" role="tabpanel" aria-labelledby="tab-services">
    <div class="panel-header">
      <div class="panel-title">
        <i class="ph-light ph-stack"></i>
        <span>Services</span>
      </div>
      <button class="action-btn primary" onclick="loadDoctor(true)">
        <span class="btn-inner">
          <span>Run Doctor</span>
          <span class="btn-icon-wrap"><i class="ph-light ph-stethoscope"></i></span>
        </span>
      </button>
    </div>
    <!-- Doctor results (matrix doctor) -->
    <div class="section-panel" id="doctorSection" style="display:none; margin-bottom:1rem">
      <div class="shell">
        <div class="inner inner--flush">
          <table class="glass-table" id="doctorTable">
            <thead>
              <tr>
                <th>Check</th>
                <th>Status</th>
                <th>Detail</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="section-panel">
      <div class="shell">
        <div class="inner inner--flush">
          <table class="glass-table">
            <thead>
              <tr>
                <th>Service</th>
                <th>Status</th>
                <th>URL</th>
                <th>Type</th>
              </tr>
            </thead>
            <tbody>
              {{#each services}}
              <tr>
                <td class="service-name">{{name}}</td>
                <td>
                  <span class="status-tag {{#if (eq status "Running")}}live{{else}}down{{/if}}">
                    <span class="status-tag-dot"></span>
                    {{status}}
                  </span>
                </td>
                <td>
                  {{#if (ne localUrl "Internal")}}
                  <a href="{{localUrl}}" target="_blank" class="table-link">{{localUrl}}</a>
                  {{else}}
                  <span class="muted">{{localUrl}}</span>
                  {{/if}}
                </td>
                <td><span class="type-badge">service</span></td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Frontend Panel -->
  <div class="tab-panel" id="panel-frontend" role="tabpanel" aria-labelledby="tab-frontend">
    <div class="panel-header">
      <div class="panel-title">
        <i class="ph-light ph-browsers"></i>
        <span>Frontend</span>
      </div>
    </div>
    <div class="bento-grid cols-2">
      <div class="bento-cell reveal">
        <div class="shell">
          <div class="inner">
            <div class="stat-header">
              <span class="stat-label">Status</span>
            </div>
            <div class="frontend-status" id="frontendStatus">Checking...</div>
            <div style="margin-top:1rem">
              <a href="http://localhost:8500" target="_blank" rel="noopener" class="action-btn primary">
                <span class="btn-inner">
                  <span>Open Dashboard</span>
                  <span class="btn-icon-wrap"><i class="ph-light ph-arrow-square-out"></i></span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="bento-cell reveal">
        <div class="shell">
          <div class="inner">
            <div class="stat-header">
              <span class="stat-label">Controls</span>
            </div>
            <div class="action-strip vertical">
              <button class="action-btn primary" onclick="frontendAction('start')">
                <span class="btn-inner"><i class="ph-light ph-play"></i> Start</span>
              </button>
              <button class="action-btn secondary" onclick="frontendAction('stop')">
                <span class="btn-inner"><i class="ph-light ph-stop"></i> Stop</span>
              </button>
              <button class="action-btn outline" onclick="frontendAction('restart')">
                <span class="btn-inner"><i class="ph-light ph-arrows-clockwise"></i> Restart</span>
              </button>
              <button class="action-btn outline" onclick="frontendAction('status')">
                <span class="btn-inner"><i class="ph-light ph-info"></i> Status</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Terminal Panel -->
  <div class="tab-panel" id="panel-terminal" role="tabpanel" aria-labelledby="tab-terminal">
    <div class="panel-header">
      <div class="panel-title">
        <i class="ph-light ph-terminal"></i>
        <span>Terminal</span>
      </div>
    </div>
    <div class="section-panel">
      <div class="shell">
        <div class="inner">
          <div class="terminal">
            <div class="terminal-bar">
              <span class="terminal-dot"></span>
              <span class="terminal-dot"></span>
              <span class="terminal-dot"></span>
              <span class="terminal-title">matrix CLI</span>
            </div>
            <div class="terminal-body" id="terminalOutput" aria-live="polite" aria-relevant="additions">
              <div class="terminal-line info">WordPress Matrix Terminal</div>
              <div class="terminal-line dim">Type 'help' for available commands</div>
              <div class="terminal-line dim sep">- - - - - - - - - - - - - -</div>
            </div>
            <div class="terminal-input-row">
              <span class="terminal-prompt">$</span>
              <input type="text" id="terminalInput" class="terminal-input" placeholder="Enter command..." onkeydown="if(event.key==='Enter')executeCommand()" autocomplete="off" spellcheck="false" aria-label="Terminal command">
              <button class="terminal-exec-btn" onclick="executeCommand()" aria-label="Run command">
                <i class="ph-light ph-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Activity Panel -->
  <div class="tab-panel" id="panel-activity" role="tabpanel" aria-labelledby="tab-activity">
    <div class="panel-header between">
      <div class="panel-title">
        <i class="ph-light ph-activity"></i>
        <span>Activity</span>
      </div>
      <button class="action-chip small" onclick="loadActivity()">
        <i class="ph-light ph-arrows-clockwise"></i> Refresh
      </button>
    </div>
    <div class="section-panel">
      <div class="shell">
        <div class="inner inner--flush">
          <table class="glass-table">
            <thead>
              <tr>
                <th>Timestamp</th>
                <th>Action</th>
                <th>Site</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody id="activityTableBody">
              <tr>
                <td colspan="4" class="center muted">Loading...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Site Modal -->
<div class="modal-overlay" id="createSiteModal">
  <div class="modal-shell">
    <div class="modal-inner">
      <div class="modal-header">
        <h3><i class="ph-light ph-plus-circle"></i> New Site</h3>
        <button class="modal-close" onclick="closeModal('createSiteModal')" aria-label="Close">
          <i class="ph-light ph-x"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="field-group">
          <label for="siteName">Site Name</label>
          <input type="text" id="siteName" placeholder="e.g. mysite" class="glass-input">
          <span class="field-hint">Alphanumeric, hyphens, underscores only</span>
        </div>
        <div class="field-group">
          <label for="siteType">Stack</label>
          <select id="siteType" class="glass-select">
            <option value="wp">WordPress (default)</option>
            <option value="laravel">Laravel (PHP 8.2+)</option>
            <option value="symfony">Symfony (PHP 8.2+)</option>
            <option value="drupal">Drupal 11 (PHP 8.3+)</option>
            <option value="joomla">Joomla 5 (PHP 8.1+)</option>
            <option value="grav">Grav (PHP 8.1+, no database)</option>
          </select>
          <span class="field-hint">Laravel/Symfony/WordPress presets and multisite apply to WordPress only</span>
        </div>
        <div class="field-group">
          <label for="phpVersion">PHP Version</label>
          <select id="phpVersion" class="glass-select">
            <option value="8.3">PHP 8.3 (default)</option>
            <option value="8.2">PHP 8.2</option>
            <option value="8.1">PHP 8.1</option>
            <option value="8.0">PHP 8.0</option>
            <option value="7.4">PHP 7.4</option>
          </select>
        </div>
        <div class="field-group">
          <label for="wpVersionSelect">WordPress Version</label>
          <select id="wpVersionSelect" class="glass-select">
            <option value="">latest (default)</option>
            <option value="6.6">WordPress 6.6</option>
            <option value="6.5">WordPress 6.5</option>
            <option value="6.4">WordPress 6.4</option>
          </select>
        </div>
        <div class="field-group">
          <label for="multisiteVersion">Multisite</label>
          <select id="multisiteVersion" class="glass-select">
            <option value="">none (default)</option>
            <option value="subdirectory">Multisite — subdirectory</option>
            <option value="subdomain">Multisite — subdomain</option>
          </select>
        </div>
        <div class="field-group">
          <label for="presetSelect">Preset</label>
          <select id="presetSelect" class="glass-select">
            <option value="">none (default)</option>
          </select>
          <span class="field-hint">Drop .sh files into config/presets/ to add more</span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="action-btn outline" onclick="closeModal('createSiteModal')"><span class="btn-inner">Cancel</span></button>
        <button class="action-btn primary" onclick="createSite()">
          <span class="btn-inner">
            <span>Create</span>
            <span class="btn-icon-wrap"><i class="ph-light ph-plus"></i></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Import Bundle Modal -->
<div class="modal-overlay" id="importBundleModal">
  <div class="modal-shell">
    <div class="modal-inner">
      <div class="modal-header">
        <h3><i class="ph-light ph-package"></i> Import Bundle</h3>
        <button class="modal-close" onclick="closeModal('importBundleModal')" aria-label="Close">
          <i class="ph-light ph-x"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="field-group">
          <label for="bundleFile">Bundle path</label>
          <input type="text" id="bundleFile" placeholder="backups/demo-bundle.tar.gz" class="glass-input">
          <span class="field-hint">Relative path inside the project</span>
        </div>
        <div class="field-group">
          <label for="importDestName">New site name</label>
          <input type="text" id="importDestName" placeholder="newsite" class="glass-input">
          <span class="field-hint">Alphanumeric, hyphens, underscores only</span>
        </div>
        <div class="field-group">
          <label for="importForce" class="checkbox-label">
            <input type="checkbox" id="importForce"> Overwrite an existing site with the same name
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="action-btn outline" onclick="closeModal('importBundleModal')"><span class="btn-inner">Cancel</span></button>
        <button class="action-btn primary" onclick="importBundle()"><span class="btn-inner">Import</span></button>
      </div>
    </div>
  </div>
</div>

<!-- Code Quality Results Modal -->
<div class="modal-overlay" id="checkResultsModal">
  <div class="modal-shell wide">
    <div class="modal-inner">
      <div class="modal-header">
        <h3><i class="ph-light ph-clipboard-text"></i> Code Quality Results</h3>
        <button class="modal-close" onclick="closeModal('checkResultsModal')" aria-label="Close">
          <i class="ph-light ph-x"></i>
        </button>
      </div>
      <div class="modal-body">
        <div id="checkProgress" class="center" style="padding:1.5rem">
          <div class="spinner"></div>
          <p style="margin-top:0.75rem">Running checks...</p>
        </div>
        <div id="checkOutput" style="display:none">
          <pre class="code-block"></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Site Detail Flyout -->
<div class="flyout-overlay" id="siteFlyoutOverlay" onclick="closeSiteFlyout()"></div>
<div class="site-flyout" id="siteFlyout" role="dialog" aria-modal="true" aria-labelledby="flyoutSiteName">
  <div class="flyout-header">
    <div class="flyout-header-info">
      <span class="flyout-site-name" id="flyoutSiteName">--</span>
      <span class="status-tag" id="flyoutSiteStatus">
        <span class="status-tag-dot"></span>
        <span id="flyoutSiteStatusText">--</span>
      </span>
    </div>
    <button class="flyout-close" onclick="closeSiteFlyout()" aria-label="Close">
      <i class="ph-light ph-x"></i>
    </button>
  </div>

  <div class="flyout-body">
    <!-- Meta row -->
    <div class="flyout-meta">
      <div class="flyout-meta-item">
        <span class="flyout-meta-label">URL</span>
        <a class="flyout-meta-value" id="flyoutSiteUrl" href="#" target="_blank">--</a>
      </div>
      <div class="flyout-meta-row">
        <div class="flyout-meta-item">
          <span class="flyout-meta-label">PHP</span>
          <span class="flyout-meta-value" id="flyoutSitePhp">--</span>
        </div>
        <div class="flyout-meta-item">
          <span class="flyout-meta-label">Port</span>
          <span class="flyout-meta-value" id="flyoutSitePort">--</span>
        </div>
        <div class="flyout-meta-item">
          <span class="flyout-meta-label">Stack</span>
          <span class="flyout-meta-value" id="flyoutSiteType">wp</span>
        </div>
      </div>
    </div>

    <!-- Health -->
    <div class="flyout-section">
      <div class="flyout-section-title">Health</div>
      <div class="flyout-health-bar" id="flyoutHealthBar">
        <span class="pulse-dot" id="flyoutHealthDot"></span>
        <span id="flyoutHealthText">Checking...</span>
        <button class="action-chip small" onclick="flyoutHealthCheck()" style="margin-left:auto">
          <i class="ph-light ph-heartbeat"></i> Check
        </button>
      </div>
    </div>

    <!-- SSL -->
    <div class="flyout-section">
      <div class="flyout-section-title">SSL</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutSsl('enable')"><i class="ph-light ph-lock-simple"></i> Enable</button>
        <button class="action-chip" onclick="flyoutSsl('revoke')"><i class="ph-light ph-lock-open"></i> Revoke</button>
        <button class="action-chip" onclick="flyoutDomain()"><i class="ph-light ph-globe"></i> Domain</button>
      </div>
      <div class="field-hint" id="flyoutSslInfo" style="margin-top:0.5rem"></div>
    </div>

    <!-- Share -->
    <div class="flyout-section">
      <div class="flyout-section-title">Share</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutShare()"><i class="ph-light ph-broadcast"></i> Start Tunnel</button>
        <button class="action-chip" onclick="flyoutShareStop()"><i class="ph-light ph-plugs-connected"></i> Stop Tunnel</button>
      </div>
      <div class="field-hint" id="flyoutShareInfo" style="margin-top:0.5rem"></div>
    </div>

    <!-- Lifecycle -->
    <div class="flyout-section">
      <div class="flyout-section-title">Lifecycle</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutAction('start')"><i class="ph-light ph-play"></i> Start</button>
        <button class="action-chip" onclick="flyoutAction('stop')"><i class="ph-light ph-stop"></i> Stop</button>
        <button class="action-chip" onclick="flyoutAction('restart')"><i class="ph-light ph-arrows-clockwise"></i> Restart</button>
      </div>
    </div>

    <!-- Info -->
    <div class="flyout-section">
      <div class="flyout-section-title">Information</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutAction('info')"><i class="ph-light ph-info"></i> Info</button>
        <button class="action-chip" onclick="flyoutAction('url')"><i class="ph-light ph-link"></i> URL</button>
        <button class="action-chip" onclick="flyoutAction('logs')"><i class="ph-light ph-terminal-window"></i> Logs</button>
        <button class="action-chip" onclick="flyoutAction('rest')"><i class="ph-light ph-currency-circle-dollar"></i> REST API</button>
        <button class="action-chip" onclick="flyoutAction('check')"><i class="ph-light ph-clipboard-text"></i> Checks</button>
        <button class="action-chip" onclick="flyoutHealthCheck()"><i class="ph-light ph-heartbeat"></i> Health</button>
      </div>
    </div>

    <!-- Database -->
    <div class="flyout-section">
      <div class="flyout-section-title">Database</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutAction('export-db')"><i class="ph-light ph-export"></i> Export</button>
        <button class="action-chip" onclick="flyoutAction('import-db')"><i class="ph-light ph-download-simple"></i> Import</button>
        <button class="action-chip" onclick="flyoutSearchReplace()"><i class="ph-light ph-arrows-left-right"></i> Search/Replace</button>
      </div>
    </div>

    <!-- Maintenance -->
    <div class="flyout-section">
      <div class="flyout-section-title">Maintenance</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutAction('backup')"><i class="ph-light ph-download-simple"></i> Backup</button>
        <button class="action-chip" onclick="flyoutAction('restore')"><i class="ph-light ph-upload-simple"></i> Restore</button>
        <button class="action-chip" onclick="flyoutAction('clone')"><i class="ph-light ph-copy"></i> Clone</button>
        <button class="action-chip" onclick="flyoutAction('reset')"><i class="ph-light ph-arrow-counter-clockwise"></i> Reset</button>
        <button class="action-chip" onclick="flyoutUpdateCore()"><i class="ph-light ph-cloud-arrow-up"></i> Update</button>
        <button class="action-chip" onclick="flyoutClearCache()"><i class="ph-light ph-broom"></i> Clear Cache</button>
      </div>
      <div class="flyout-action-grid cols-3" style="margin-top:0.5rem">
        <button class="action-chip" onclick="flyoutExportBundle()"><i class="ph-light ph-package"></i> Export Bundle</button>
        <button class="action-chip" onclick="flyoutCompat()"><i class="ph-light ph-flask"></i> Test Compat</button>
        <button class="action-chip" onclick="flyoutScheduleBackup()"><i class="ph-light ph-calendar-plus"></i> Schedule</button>
      </div>
      <div class="flyout-action-grid cols-2" style="margin-top:0.5rem">
        <button class="action-chip" onclick="flyoutCron('install')"><i class="ph-light ph-clock-clockwise"></i> Cron Install</button>
        <button class="action-chip" onclick="flyoutCron('remove')"><i class="ph-light ph-clock-counter-clockwise"></i> Cron Remove</button>
      </div>
    </div>

    <!-- Advanced -->
    <div class="flyout-section">
      <div class="flyout-section-title">Advanced</div>
      <div class="flyout-action-grid cols-3">
        <button class="action-chip" onclick="flyoutEditPhp()"><i class="ph-light ph-pencil"></i> Edit PHP</button>
        <button class="action-chip" onclick="flyoutAction('xdebug')"><i class="ph-light ph-bug"></i> Xdebug</button>
        <button class="action-chip" onclick="flyoutAction('repair')"><i class="ph-light ph-wrench"></i> Repair</button>
      </div>
      <div class="flyout-wpcli" style="margin-top:0.5rem">
        <div class="flyout-wpcli-row">
          <span class="flyout-wpcli-prompt">$</span>
          <input type="text" id="flyoutWpcliInput" class="flyout-wpcli-input" placeholder="wp plugin list --status=active" autocomplete="off" spellcheck="false" aria-label="WP-CLI command">
          <button class="action-chip small" onclick="flyoutWpcli()" aria-label="Run WP-CLI command"><i class="ph-light ph-arrow-right"></i></button>
        </div>
      </div>
    </div>

    <!-- Danger -->
    <div class="flyout-section flyout-section-danger">
      <div class="flyout-action-grid cols-2">
        <button class="action-chip danger" onclick="flyoutAction('remove')"><i class="ph-light ph-trash"></i> Delete Site</button>
      </div>
    </div>
  </div>
</div>

