<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="WordPress development environment manager">
  <meta property="og:title" content="{{title}} — WordPress Matrix">
  <meta property="og:description" content="WordPress development environment manager">
  <meta property="og:type" content="website">
  <link rel="icon" href="/icons/favicon.ico">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="manifest" href="/icons/site.webmanifest">
  <title>{{title}} — WordPress Matrix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {{! Third-party CSS is non-blocking (print-swap): first paint must not
     wait on fonts.googleapis/jsdelivr — the dashboard runs on a LAN that
     may have no internet. Fonts use display=swap; icons pop in on load. }}
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <link href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/light/style.css" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/light/style.css" rel="stylesheet">
  </noscript>
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <a href="#mainContent" class="skip-link">Skip to content</a>
  <div class="scanlines"></div>
  <div class="noise-overlay"></div>
  <canvas id="particlesCanvas"></canvas>

  <!-- Terminal Header (tmux-style) -->
  <header class="term-header">
    <nav class="term-nav">
      <span class="term-brand">
        <img class="brand-mark" src="/icons/favicon.svg" alt="" width="18" height="18">
        MATRIX<span class="version">@v2</span>
      </span>
      <span class="term-divider"></span>
      <div class="tab-strip" id="tabStrip" role="tablist" aria-label="Sections">
        <button class="tab-pill active" data-tab="dashboard" id="tab-dashboard" role="tab" aria-selected="true" aria-controls="panel-dashboard">
          <span class="tab-idx">0</span>
          <span>Dashboard</span>
        </button>
        <button class="tab-pill" data-tab="sites" id="tab-sites" role="tab" aria-selected="false" aria-controls="panel-sites">
          <span class="tab-idx">1</span>
          <span>Sites</span>
        </button>
        <button class="tab-pill" data-tab="services" id="tab-services" role="tab" aria-selected="false" aria-controls="panel-services">
          <span class="tab-idx">2</span>
          <span>Services</span>
        </button>
        <button class="tab-pill" data-tab="frontend" id="tab-frontend" role="tab" aria-selected="false" aria-controls="panel-frontend">
          <span class="tab-idx">3</span>
          <span>Frontend</span>
        </button>
        <button class="tab-pill" data-tab="terminal" id="tab-terminal" role="tab" aria-selected="false" aria-controls="panel-terminal">
          <span class="tab-idx">4</span>
          <span>Terminal</span>
        </button>
        <button class="tab-pill" data-tab="activity" id="tab-activity" role="tab" aria-selected="false" aria-controls="panel-activity">
          <span class="tab-idx">5</span>
          <span>Activity</span>
        </button>
      </div>
      <div class="term-controls">
        <button class="term-btn" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">
          <i class="ph-light ph-monitor" id="theme-icon"></i>
          <span id="theme-label">Theme</span>
        </button>
      </div>
    </nav>
  </header>

  <div class="app-container" id="appContainer">
    <!-- Content -->
    <main class="main-content" id="mainContent" tabindex="-1">
      <div class="content-header">
        <h1 class="page-title">{{title}}</h1>
        <div class="content-actions">
          <button class="btn-icon-only" id="refreshBtn" aria-label="Refresh">
            <i class="ph-light ph-arrows-clockwise"></i>
            <span>Refresh</span>
          </button>
        </div>
      </div>
      {{{body}}}
    </main>
  </div>

  <!-- Status Bar -->
  <div class="status-bar">
    <div class="status-bar-left">
      <span class="status-item" id="connectionStatus" role="status">
        <span class="status-dot"></span>
        <span class="status-label">Connecting...</span>
      </span>
      <span class="status-item">
        <i class="ph-light ph-clock"></i>
        <span>Updated <span id="lastUpdateTime">--</span></span>
      </span>
    </div>
    <div class="status-bar-right">
      <span class="status-item hint">
        <span class="kb">?</span> shortcuts
      </span>
    </div>
  </div>

  {{! Same-origin socket.io client — served by the local socket.io route
     (deflate-compressed), no CDN dependency. }}
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
