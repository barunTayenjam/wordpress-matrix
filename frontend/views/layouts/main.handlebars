<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="WordPress development environment manager">
  <meta property="og:title" content="{{title}} — WordPress Matrix">
  <meta property="og:description" content="WordPress development environment manager">
  <meta property="og:type" content="website">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%232dd4bf'/%3E%3Ctext x='16' y='22' text-anchor='middle' fill='%23080a0a' font-size='16' font-weight='700' font-family='monospace'%3EW%3C/text%3E%3C/svg%3E">
  <title>{{title}} — WordPress Matrix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/dist/phosphor-icons.css">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <a href="#mainContent" class="skip-link">Skip to content</a>
  <div class="scanlines"></div>
  <div class="noise-overlay"></div>
  <canvas id="particlesCanvas"></canvas>

  <!-- Terminal Header (tmux-style) -->
  <header class="term-header">
    <nav class="term-nav">
      <span class="term-brand">
        <i class="ph-light ph-terminal-window"></i>
        MATRIX<span class="version">@v2</span>
      </span>
      <span class="term-divider"></span>
      <div class="tab-strip" id="tabStrip">
        <button class="tab-pill active" data-tab="dashboard" id="tab-dashboard">
          <span class="tab-idx">0</span>
          <span>Dashboard</span>
        </button>
        <button class="tab-pill" data-tab="sites" id="tab-sites">
          <span class="tab-idx">1</span>
          <span>Sites</span>
        </button>
        <button class="tab-pill" data-tab="services" id="tab-services">
          <span class="tab-idx">2</span>
          <span>Services</span>
        </button>
        <button class="tab-pill" data-tab="frontend" id="tab-frontend">
          <span class="tab-idx">3</span>
          <span>Frontend</span>
        </button>
        <button class="tab-pill" data-tab="terminal" id="tab-terminal">
          <span class="tab-idx">4</span>
          <span>Terminal</span>
        </button>
        <button class="tab-pill" data-tab="activity" id="tab-activity">
          <span class="tab-idx">5</span>
          <span>Activity</span>
        </button>
      </div>
      <div class="term-controls">
        <button class="term-btn" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">
          <i class="ph-light ph-monitor" id="theme-icon"></i>
          <span id="theme-label">Theme</span>
        </button>
      </div>
    </nav>
  </header>

  <div class="app-container" id="appContainer">
    <!-- Content -->
    <main class="main-content" id="mainContent" tabindex="-1">
      <div class="content-header">
        <h1 class="page-title">{{title}}</h1>
        <div class="content-actions">
          <button class="btn-icon-only" id="refreshBtn">
            <i class="ph-light ph-arrows-clockwise"></i>
            <span>Refresh</span>
          </button>
        </div>
      </div>
      {{{body}}}
    </main>
  </div>

  <!-- Status Bar -->
  <div class="status-bar">
    <div class="status-bar-left">
      <span class="status-item" id="connectionStatus">
        <span class="status-dot online"></span>
        <span>Connected</span>
      </span>
      <span class="status-item">
        <i class="ph-light ph-clock"></i>
        <span>Updated <span id="lastUpdateTime">--</span></span>
      </span>
    </div>
    <div class="status-bar-right">
      <span class="status-item hint">
        <span class="kb">?</span> shortcuts
      </span>
    </div>
  </div>

  <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
