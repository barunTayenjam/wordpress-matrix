<div class="tab-panel active">
  <div class="error-page">
    <div class="error-card">
      <div class="shell">
        <div class="inner">
          <i class="ph-light ph-warning error-icon"></i>
          <h3 class="error-title">Error</h3>
          <p class="error-message">{{error}}</p>
          <div class="error-actions">
            <button class="action-btn outline" onclick="history.back()">
              <span class="btn-inner"><i class="ph-light ph-arrow-left"></i> Back</span>
            </button>
            <button class="action-btn primary" onclick="location.reload()">
              <span class="btn-inner">
                <span>Retry</span>
                <span class="btn-icon-wrap"><i class="ph-light ph-arrows-clockwise"></i></span>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
